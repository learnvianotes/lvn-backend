# Canonical list: docs/architecture/env.md. Every URL, origin and connection string lives here, never in code
# (ADR-0022). Copy to .env (git-ignored) and put personal overrides in .env.local.
# Local services: `pnpm infra:up` (infra/docker/compose.yaml) — the ports below are that file's defaults.
APP_ENV=development
LOG_LEVEL=debug
# Observability (§16.5), all optional: OTLP/HTTP collector for traces and metrics, Sentry for unexpected errors, and
# the release name both report (image tag or commit SHA in sandbox and production).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# SENTRY_DSN=
# RELEASE=
DATABASE_URL=postgresql://lvn:lvn@localhost:55432/lvn
REDIS_URL=redis://localhost:56379
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
WORKER_HEALTH_PORT=4001

# Object storage (§8, ADR-0032): RustFS locally, Amazon S3 in sandbox and production (leave S3_ENDPOINT unset there).
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=lvn-dev
S3_SECRET_ACCESS_KEY=lvn-dev-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET=lvn-files
S3_RESTRICTED_BUCKET=lvn-restricted

# Email: Mailpit locally (read it at http://localhost:58025); Resend in sandbox and production.
MAIL_FROM=LearnViaNotes <no-reply@learnvianotes.in>
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:51025
# RESEND_API_KEY=

# Sessions (§7.1). `pnpm keys:dev` writes JWT_PRIVATE_KEY / JWT_PUBLIC_KEY and CODE_HMAC_SECRET to .env.local.
JWT_ISSUER=http://localhost:4000
WEB_URL=http://localhost:3000
PASSWORD_BREACH_API_URL=https://api.pwnedpasswords.com/range
# Age below which an account is a restricted minor until consent is verified (ADR-0017; DPDP Act §9 → 18).
# DIGITAL_CONSENT_AGE=18
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# CODE_HMAC_SECRET=

# Sign-in providers — a provider without credentials is switched off (ADR-0007).
# FIREBASE_PROJECT_ID=
# The old site's Firebase project, read once by `pnpm --filter @lvn-backend/worker legacy:snapshot` (ADR-0023);
# credentials come from GOOGLE_APPLICATION_CREDENTIALS.
# LEGACY_FIREBASE_PROJECT_ID=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
GITHUB_OAUTH_URL=https://github.com
GITHUB_API_URL=https://api.github.com
LINKEDIN_OAUTH_URL=https://www.linkedin.com/oauth/v2
LINKEDIN_API_URL=https://api.linkedin.com/v2
# Exactly the redirect URIs registered with GitHub and LinkedIn: the web callback and the app's deep link.
OAUTH_REDIRECT_URIS=http://localhost:3000/oauth/callback
