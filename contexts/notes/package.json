{
  "name": "@lvn-backend/notes",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/graphql-types.mjs notes && tsc -p tsconfig.build.json && cp src/graphql/*.graphql dist/graphql/",
    "typecheck": "node ../../scripts/graphql-types.mjs notes --check && tsc --noEmit",
    "lint": "eslint src",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests"
  },
  "dependencies": {
    "@lvn-backend/auth-guard": "workspace:*",
    "@lvn-backend/errors": "workspace:*",
    "@lvn-backend/event-bus": "workspace:*",
    "@lvn-backend/facades": "workspace:*",
    "@lvn-backend/graphql": "workspace:*",
    "@lvn-backend/prisma-base": "workspace:*",
    "@lvn-backend/queue": "workspace:*",
    "@lvn-backend/redis": "workspace:*",
    "@lvn-backend/scanner-protocol": "workspace:*",
    "@lvn-backend/storage": "workspace:*",
    "@lvn/contracts": "workspace:@learnvianotes/contracts@*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/graphql": "14.0.3",
    "@opentelemetry/api": "1.9.1",
    "fflate": "^0.8.3",
    "graphql": "16.14.2",
    "marked": "15.0.12",
    "pdf-lib": "1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@lvn-backend/testing": "workspace:*"
  }
}
