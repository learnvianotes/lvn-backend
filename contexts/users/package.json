{
  "name": "@lvn-backend/users",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/graphql-types.mjs users && tsc -p tsconfig.build.json && cp src/graphql/*.graphql dist/graphql/",
    "typecheck": "node ../../scripts/graphql-types.mjs users --check && tsc --noEmit",
    "lint": "eslint src test",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests"
  },
  "dependencies": {
    "@lvn-backend/auth-guard": "workspace:*",
    "@lvn-backend/config": "workspace:*",
    "@lvn-backend/errors": "workspace:*",
    "@lvn-backend/event-bus": "workspace:*",
    "@lvn-backend/facades": "workspace:*",
    "@lvn-backend/graphql": "workspace:*",
    "@lvn-backend/observability": "workspace:*",
    "@lvn-backend/legacy": "workspace:*",
    "@lvn-backend/prisma-base": "workspace:*",
    "@lvn-backend/queue": "workspace:*",
    "@lvn-backend/redis": "workspace:*",
    "@lvn-backend/safe-fetch": "workspace:*",
    "@lvn-backend/storage": "workspace:*",
    "@lvn/contracts": "workspace:@learnvianotes/contracts@*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/graphql": "14.0.3",
    "argon2": "^0.45.1",
    "fflate": "^0.8.3",
    "firebase-admin": "^14.5.0",
    "graphql": "16.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  }
}
