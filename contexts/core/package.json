{
  "name": "@lvn-backend/core",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/graphql-types.mjs core && tsc -p tsconfig.build.json && cp src/graphql/*.graphql dist/graphql/",
    "typecheck": "node ../../scripts/graphql-types.mjs core --check && tsc --noEmit",
    "lint": "eslint src",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@lvn-backend/auth-guard": "workspace:*",
    "@lvn-backend/errors": "workspace:*",
    "@lvn-backend/event-bus": "workspace:*",
    "@lvn-backend/facades": "workspace:*",
    "@lvn-backend/graphql": "workspace:*",
    "@lvn-backend/legacy": "workspace:*",
    "@lvn-backend/prisma-base": "workspace:*",
    "@lvn-backend/redis": "workspace:*",
    "@lvn-backend/storage": "workspace:*",
    "@lvn/contracts": "workspace:@learnvianotes/contracts@*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/graphql": "13.4.5",
    "graphql": "16.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
