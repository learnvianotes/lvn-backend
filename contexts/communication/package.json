{
  "name": "@lvn-backend/communication",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/graphql-types.mjs communication && tsc -p tsconfig.build.json && cp src/graphql/*.graphql dist/graphql/",
    "typecheck": "node ../../scripts/graphql-types.mjs communication --check && tsc --noEmit",
    "lint": "eslint src test",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1176.0",
    "@lvn-backend/auth-guard": "workspace:*",
    "@lvn-backend/errors": "workspace:*",
    "@lvn-backend/event-bus": "workspace:*",
    "@lvn-backend/facades": "workspace:*",
    "@lvn-backend/graphql": "workspace:*",
    "@lvn-backend/prisma-base": "workspace:*",
    "@lvn-backend/queue": "workspace:*",
    "@lvn-backend/redis": "workspace:*",
    "@lvn/contracts": "workspace:@learnvianotes/contracts@*",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/graphql": "14.2.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "graphql": "16.14.2",
    "graphql-ws": "6.4.3",
    "ioredis": "^6.1.0",
    "nodemailer": "^10.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.39.0",
    "rxjs": "^7.8.2",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@lvn-backend/testing": "workspace:*",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.2"
  }
}
