# Settings of the AWS stand-in (ADR-0066): the sandbox's Terraform (envs/sandbox and every module) applied to Moto, an
# AWS emulator, on a small VM on this machine, until there is an AWS account. Nothing runs on it: Moto only records
# what Terraform asks for. Copy to .env here (git-ignored). Read by infra/scripts/aws-stand-in.sh, which runs
# infra/local-vm/vm.sh with LVN_VM_ENV=emulated, and by infra/terraform/run.sh and bootstrap.sh inside the VM.

# The sandbox's root module, with this environment's own state (in the emulator's bucket) and .terraform directory.
TF_ROOT=sandbox
TF_STATE_BUCKET=lvn-emulated-tfstate

# Moto in the VM, also reachable on this machine at the same address. Any credentials work; the account is
# 123456789012. S3 Control calls go to 123456789012.localhost, which the VM resolves to itself. Moto is pinned by
# version and digest; update both together.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-south-1
LVN_MOTO_IMAGE=motoserver/moto:5.2.3@sha256:91fd602a21f49cf9eb82fdf474015a3c131d40104c8297ea6a2ca920708ae32c

# The sandbox's variables (envs/sandbox/variables.tf), as the sandbox's .env sets them.
TF_VAR_aws_emulator=true
TF_VAR_region=ap-south-1
TF_VAR_name=lvn-emulated
TF_VAR_mail_from_address=no-reply@learnvianotes.local
TF_VAR_nat_gateway=true
# No budget: Moto cannot read a budget's subscribers back (ADR-0066).
TF_VAR_budget_alert_email=

# The VM (infra/local-vm/vm.sh). Its disk, key and logs live in LVN_VM_DIR. Moto keeps everything in memory, so a VM
# that stops forgets the emulated account; aws-stand-in.sh up creates the state bucket again.
LVN_VM_DIR=$HOME/.local/share/lvn-aws-vm
LVN_VM_CPUS=2
LVN_VM_MEMORY_MB=3072
LVN_VM_DISK=20G
LVN_VM_SSH_PORT=2223
LVN_VM_HTTP_PORT=off
LVN_VM_S3_PORT=off
LVN_VM_MAIL_PORT=off
LVN_VM_FORWARDS=127.0.0.1:4566-:4566
