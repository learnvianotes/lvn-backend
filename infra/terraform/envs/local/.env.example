# Settings of the local environment (ADR-0036): the stack on a VM on this machine, standing in for the AWS sandbox.
# Copy to .env here (git-ignored). Read by infra/local-vm/vm.sh, infra/terraform/run.sh and infra/scripts/deploy-local.sh.

# Terraform keeps this environment's state inside the VM; there is no state bucket.
TF_BACKEND=local

# The VM (infra/local-vm/vm.sh). Its disk, key and logs live in LVN_VM_DIR (default ~/.local/share/lvn-vm).
LVN_VM_CPUS=6
# 8 GB: the apps, the PDF engine (3 GB cap) and ClamAV (2 GB cap, ADR-0041).
LVN_VM_MEMORY_MB=8192
LVN_VM_DISK=40G
LVN_VM_SSH_PORT=2222
# Host addresses the environment listens on: 127.0.0.1, plus the address phones reach this machine on (Tailscale).
LVN_VM_PUBLISH_ADDRESSES=127.0.0.1
LVN_VM_HTTP_PORT=8080
LVN_VM_S3_PORT=8081
# Mailpit, on 127.0.0.1 only: every email the environment sends.
LVN_VM_MAIL_PORT=8025

# The environment's public addresses, as browsers and phones reach them: the entrance (web, and the API at /graphql)
# and the S3 endpoint that pre-signed upload and download URLs point at. Use an address from LVN_VM_PUBLISH_ADDRESSES.
TF_VAR_public_url=http://127.0.0.1:8080
TF_VAR_s3_public_url=http://127.0.0.1:8081

TF_VAR_mail_from_address=no-reply@learnvianotes.local
TF_VAR_mail_from_name=LearnViaNotes

# Google sign-in (Firebase, ADR-0007): the project id for the API, the web app's config for the web build. Add the
# public_url's host to Firebase → Authentication → Settings → Authorized domains.
# Never the production project here: the web build refuses it outside production (ADR-0093, lvn-web
# config/firebase-projects.json). The sandbox uses the test project, learnvianotes-test.
TF_VAR_firebase_project_id=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: Sentry DSNs (backend, web) and an OTLP/HTTP collector.
TF_VAR_sentry_dsn=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: Google Analytics 4 (ADR-0092), loaded only after a visitor allows it. Empty: no analytics, no banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
TF_VAR_otel_exporter_otlp_endpoint=

# TF_VAR_log_level=info
# Any other api/worker variable from docs/architecture/env.md, as an HCL map:
# TF_VAR_extra_backend_environment={DIGITAL_CONSENT_AGE="18"}
