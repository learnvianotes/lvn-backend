# Settings of the sandbox environment. Copy to .env here (git-ignored) and fill in the empty values.
# Read by infra/terraform/run.sh and bootstrap.sh and by infra/scripts/deploy.sh; Terraform reads every TF_VAR_* as
# the variable of the same name (variables.tf). No domain is needed: the site and API are served on CloudFront's
# https://<id>.cloudfront.net address, which the first apply prints.

# AWS CLI profile with administrator rights in the sandbox account (`aws configure sso` or `aws configure`).
AWS_PROFILE=lvn-sandbox
TF_VAR_region=ap-south-1
# Terraform state bucket; empty means lvn-sandbox-tfstate-<account id>, created by bootstrap.sh.
TF_STATE_BUCKET=

# Email (Amazon SES): an address you own. After the first apply AWS emails it a verification link. Until SES grants
# production access (SES console → Request production access), mail reaches only verified addresses, 200 a day.
TF_VAR_mail_from_address=
TF_VAR_mail_from_name=LearnViaNotes

# Google sign-in (Firebase, ADR-0007). The API needs only the project id; the web build needs the Firebase web app's
# config (public values). Add the CloudFront host to Firebase → Authentication → Settings → Authorized domains.
# Never the production project here: the web build refuses it outside production (ADR-0093, lvn-web
# config/firebase-projects.json). The sandbox uses the test project, learnvianotes-test.
TF_VAR_firebase_project_id=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Error reports and telemetry (optional): Sentry DSNs of the backend and web projects, an OTLP/HTTP collector.
TF_VAR_sentry_dsn=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: Google Analytics 4 (ADR-0092), loaded only after a visitor allows it. Empty: no analytics, no banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
TF_VAR_otel_exporter_otlp_endpoint=

# Cost. false runs the tasks in public subnets (inbound still only through the load balancer) and saves the NAT
# gateway, the largest fixed cost.
TF_VAR_nat_gateway=true
# Monthly budget alerts (forecast over 80 %, actual over 100 %) to this address; empty creates no budget.
TF_VAR_budget_monthly_usd=150
TF_VAR_budget_alert_email=

# Sizes and counts (defaults suit a sandbox).
# TF_VAR_db_instance_class=db.t4g.micro
# TF_VAR_redis_node_type=cache.t4g.micro
# TF_VAR_api_count=1
# TF_VAR_worker_count=1
# TF_VAR_web_count=1
# TF_VAR_log_level=info
# Any other api/worker variable from docs/architecture/env.md, as an HCL map:
# TF_VAR_extra_backend_environment={DIGITAL_CONSENT_AGE="18"}
