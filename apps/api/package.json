{
  "name": "@lvn-backend/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:security": "NODE_OPTIONS=--experimental-vm-modules jest test/security"
  },
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@as-integrations/express5": "^1.1.2",
    "@lvn-backend/ai": "workspace:*",
    "@lvn-backend/auth-guard": "workspace:*",
    "@lvn-backend/communication": "workspace:*",
    "@lvn-backend/config": "workspace:*",
    "@lvn-backend/core": "workspace:*",
    "@lvn-backend/errors": "workspace:*",
    "@lvn-backend/event-bus": "workspace:*",
    "@lvn-backend/facades": "workspace:*",
    "@lvn-backend/graphql": "workspace:*",
    "@lvn-backend/notes": "workspace:*",
    "@lvn-backend/observability": "workspace:*",
    "@lvn-backend/prisma-base": "workspace:*",
    "@lvn-backend/queue": "workspace:*",
    "@lvn-backend/redis": "workspace:*",
    "@lvn-backend/storage": "workspace:*",
    "@lvn-backend/users": "workspace:*",
    "@lvn/contracts": "workspace:@learnvianotes/contracts@*",
    "@nestjs/apollo": "14.2.1",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/graphql": "14.2.1",
    "@nestjs/platform-express": "^12.6.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "graphql": "16.14.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@lvn-backend/legacy": "workspace:*",
    "@lvn-backend/scanner-protocol": "workspace:*",
    "@lvn-backend/testing": "workspace:*",
    "@nestjs/cli": "^12.0.15",
    "@nestjs/testing": "^12.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "@types/ws": "8.18.2",
    "fflate": "^0.8.3",
    "graphql-ws": "6.4.3",
    "sharp": "0.35.5",
    "supertest": "^7.3.2",
    "ws": "8.23.0"
  }
