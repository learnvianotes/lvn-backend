{
  "name": "lvn-backend",
  "version": "0.7.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@lvn-backend/api --filter=@lvn-backend/worker",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "boundaries": "depcruise apps contexts libs contracts/src --config .dependency-cruiser.cjs",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "infra:up": "docker compose -f infra/docker/compose.yaml up -d --wait",
    "infra:down": "docker compose -f infra/docker/compose.yaml down",
    "keys:dev": "node scripts/dev-keys.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "graphql:export": "node scripts/export-supergraph.mjs",
    "graphql:check": "node scripts/export-supergraph.mjs --check",
    "env:check": "node scripts/env-check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "lifecycle": "node scripts/lifecycle-check.mjs",
    "search:bench": "node scripts/search-bench.mjs"
  },
  "dependencies": {
    "prisma": "7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.6",
    "dependency-cruiser": "^18.9.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
