// LearnViaNotes database — one PostgreSQL 16 database today, one schema per bounded context (spec §3, §6.1).
//
// Rules (checked in review and in CI):
// - Every model carries @@schema("users" | "notes" | "core" | "ai" | "comms").
// - No relation (foreign key) crosses schemas; cross-context references are plain UUID columns.
// - Ids are UUIDv7 generated by the application (libs/prisma-base newId()).
// - Indexes ship in the migration that introduces the query (§6.3).
//
// Target shape: docs/architecture/erd.md. Phase 1 adds the `users` models and `notes.FileObject` (uploads); Phase 2
// adds notes, cards, versions, folders, tags, subjects and topics.

generator client {
  provider        = "prisma-client"
  output          = "../libs/prisma-base/src/generated"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  schemas    = ["users", "notes", "core", "ai", "comms"]
  extensions = [vector, pg_trgm, citext]
}

// ── users ────────────────────────────────────────────────────────────────────────────────────────────────

enum GlobalRole {
  STUDENT
  TEACHER
  /// Reviews student verification (documents included). Cannot grant roles or approve teacher applications.
  MANAGER
  PLATFORM_ADMIN

  @@schema("users")
}

enum OAuthProvider {
  GOOGLE
  GITHUB
  LINKEDIN

  @@schema("users")
}

enum VerificationMethod {
  INSTITUTIONAL_EMAIL
  TEACHER
  DOCUMENTS

  @@schema("users")
}

enum VerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN

  @@schema("users")
}

/// What the ID-card check decided. A mismatch is never an automatic rejection.
enum IdCardVerdict {
  MATCH
  MISMATCH
  UNREADABLE

  @@schema("users")
}

/// Where an error or usage event was recorded.
enum ClientPlatform {
  WEB
  MOBILE
  BACKEND

  @@schema("users")
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  /// Confirms a password sign-up against an account that already exists (Google, GitHub, LinkedIn) before the password is stored
  LINK_EMAIL

  @@schema("users")
}

enum ConsentKind {
  TERMS
  PRIVACY
  PUBLIC_CONTENT_LICENCE
  /// Verified parental or institutional consent for a minor (§15.2)
  GUARDIAN

  @@schema("users")
}

enum OrgRole {
  ORG_ADMIN
  TEACHER
  STUDENT

  @@schema("users")
}

enum DomainReviewStatus {
  /// Recognised academic suffix: accepted, organisation to be created (ADR-0017)
  ACADEMIC_QUEUED
  /// Unknown domain: platform admin decides
  NEEDS_REVIEW
  APPROVED
  REJECTED

  @@schema("users")
}

enum YearOfStudy {
  YEAR_1
  YEAR_2
  YEAR_3
  YEAR_4
  YEAR_5
  POSTGRADUATE
  GRADUATED
  SCHOOL
  NOT_STUDYING

  @@schema("users")
}

enum LimitKey {
  STORAGE_BYTES
  AI_TOKENS_DAILY
  PDF_PAGES_MONTHLY
  GROUPS_OWNED
  GROUP_MEMBERS
  CLASSROOMS_OWNED
  CLASSROOM_MEMBERS
  PROJECT_WORKSPACES
  EXPORTS_DAILY
  IMPORTS_DAILY
  ORG_SEATS
  NOTES_OWNED
  AI_REQUESTS_DAILY

  @@schema("users")
}

enum LegacyImportStatus {
  NOT_FOUND
  AVAILABLE
  CLAIMED
  DECLINED

  @@schema("users")
}

model User {
  id                      String              @id @db.Uuid
  email                   String              @unique @db.Citext
  handle                  String              @unique
  displayName             String
  /// Argon2id; null for accounts that only sign in with a provider
  passwordHash            String?
  emailVerifiedAt         DateTime?           @db.Timestamptz(3)
  /// Accounts registered before ADR-0104, or set by a platform admin; never shown to anyone, only the derived age band is used.
  /// Registration now asks for an age instead (declaredAge). When present it decides the age.
  dateOfBirth             DateTime?           @db.Date
  /// ADR-0104: the whole-number age (1–120) given at registration, or by an admin. Used when there is no dateOfBirth.
  declaredAge             Int?
  /// When declaredAge was given. The age now is declaredAge plus the whole years since, never more than the real age.
  ageDeclaredAt           DateTime?           @db.Timestamptz(3)
  registrationCompletedAt DateTime?           @db.Timestamptz(3)
  /// Claimed when the one welcome email goes out. A retry, a profile edit or another sign-in does not send a second one.
  welcomeEmailSentAt      DateTime?           @db.Timestamptz(3)
  /// Verified by institutional email, a teacher or platform admins (ADR-0019)
  verifiedAt              DateTime?           @db.Timestamptz(3)
  verificationMethod      VerificationMethod?
  globalRole              GlobalRole          @default(STUDENT)
  /// Cross-context reference to notes.FileObject
  avatarFileId            String?             @db.Uuid
  deletionRequestedAt     DateTime?           @db.Timestamptz(3)
  deletedAt               DateTime?           @db.Timestamptz(3)
  /// Suspended by platform moderators until this time (ADR-0053); nothing reaches other people meanwhile
  suspendedUntil          DateTime?           @db.Timestamptz(3)
  /// Why, for the account's owner alone
  suspensionReason        String?
  /// When true, usage analytics for this account are not stored (DPDP). Error reports from the app are stored without this id.
  analyticsOptOut         Boolean             @default(false)
  /// AGE_BLOCKED has no session and is not public. BLOCKED and SUSPENDED are reversible admin holds.
  accountStatus           AccountStatus       @default(ACTIVE)
  /// Why the account is age-blocked, blocked, or suspended. Admins read it; it is not a public field.
  statusReason            String?
  createdAt               DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @db.Timestamptz(3)

  sessions             Session[]
  oauthAccounts        OAuthAccount[]
  emailTokens          EmailToken[]
  institutionalEmails  InstitutionalEmail[]
  consents             ConsentRecord[]
  dataExports          DataExport[]
  memberships          Membership[]
  verificationRequests VerificationRequest[] @relation("requester")
  profile              StudentProfile?
  plan                 UserPlan?
  legacyImport         LegacyImport?
  following            Follow[]              @relation("following")
  followers            Follow[]              @relation("followers")
  blocking             Block[]               @relation("blocking")
  blockedBy            Block[]               @relation("blockedBy")
  restricting          Restriction[]         @relation("restricting")
  restrictedBy         Restriction[]         @relation("restrictedBy")
  connectionsLow       Connection[]          @relation("connectionLow")
  connectionsHigh      Connection[]          @relation("connectionHigh")
  connectionRequests   ConnectionRequest[]   @relation("connectionFrom")
  connectionInvites    ConnectionRequest[]   @relation("connectionTo")
  teacherProfile       TeacherProfile?
  teacherSkills        TeacherSkill[]
  externalIdentities   ExternalIdentity[]

  @@index([accountStatus, createdAt(sort: Desc)])
  @@schema("users")
}

enum AccountStatus {
  ACTIVE
  AGE_BLOCKED
  BLOCKED
  SUSPENDED

  @@schema("users")
}

/// One person following another (ADR-0013, ADR-0014, ADR-0016, ADR-0020, ADR-0043): one-way, no approval. Only the
/// person followed sees the list; others see a milestone.
model Follow {
  followerId String   @db.Uuid
  followeeId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  follower   User     @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  followee   User     @relation("followers", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId, createdAt(sort: Desc)])
  @@index([followerId, createdAt(sort: Desc)])
  @@schema("users")
}

/// A block (§15.1, ADR-0016): ends follows both ways and stops new interaction both ways; the other side is not told.
model Block {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  blocker   User     @relation("blocking", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@schema("users")
}

/// A restriction (ADR-0016): the restricted person's comments wait for approval and they cause no notifications.
model Restriction {
  restricterId String   @db.Uuid
  restrictedId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  restricter   User     @relation("restricting", fields: [restricterId], references: [id], onDelete: Cascade)
  restricted   User     @relation("restrictedBy", fields: [restrictedId], references: [id], onDelete: Cascade)

  @@id([restricterId, restrictedId])
  @@index([restrictedId])
  @@schema("users")
}

/// One row per refresh token. Rotation creates the next row in the same family; presenting a rotated token revokes
/// the whole family (§7.1). The access token's `sid` claim is the family id.
model Session {
  id               String    @id @db.Uuid
  userId           String    @db.Uuid
  familyId         String    @db.Uuid
  /// SHA-256 of the 256-bit refresh token
  refreshTokenHash Bytes     @unique
  /// { platform, name, userAgent } — never the IP in clear
  device           Json?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime  @db.Timestamptz(3)
  /// Set when rotated (replacedById) or signed out / revoked
  revokedAt        DateTime? @db.Timestamptz(3)
  replacedById     String?   @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@schema("users")
}

/// A sign-in identity, separate from the person (ADR-0100): one row per provider account. The email method is the
/// user's password, not a row here — the address is already unique on User. Unique on (provider, providerSubject).
model OAuthAccount {
  id              String        @id @db.Uuid
  userId          String        @db.Uuid
  provider        OAuthProvider
  /// Stable id at the provider. GOOGLE: the Firebase UID (ADR-0007). GitHub: the numeric user id. LinkedIn: `sub`.
  providerSubject String
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@schema("users")
}

/// Single-use links for login-email verification, password reset, and attaching a password to an existing account.
/// Only the SHA-256 of the token is stored.
model EmailToken {
  id           String            @id @db.Uuid
  userId       String            @db.Uuid
  purpose      EmailTokenPurpose
  tokenHash    Bytes             @unique
  expiresAt    DateTime          @db.Timestamptz(3)
  usedAt       DateTime?         @db.Timestamptz(3)
  /// Argon2id password to set when a LINK_EMAIL token is used. Null for every other purpose, and cleared once used.
  passwordHash String?
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@schema("users")
}

/// A college or organisation email (ADR-0017). One confirmed address verifies one account at a time (partial unique
/// index in the migration); replacing an address keeps the old one until the new one is confirmed.
model InstitutionalEmail {
  id             String    @id @db.Uuid
  userId         String    @db.Uuid
  email          String    @db.Citext
  domain         String
  organizationId String?   @db.Uuid
  /// HMAC-SHA-256 of the 6-digit code (CODE_HMAC_SECRET)
  codeHash       Bytes?
  codeExpiresAt  DateTime? @db.Timestamptz(3)
  attempts       Int       @default(0)
  verifiedAt     DateTime? @db.Timestamptz(3)
  /// Set when a newer address is confirmed
  replacedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([email])
  @@schema("users")
}

/// Read model of organisations (owned by the admin app later); email domains link users to them (ADR-0017).
model Organization {
  id           String   @id @db.Uuid
  name         String
  emailDomains String[]
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  memberships         Membership[]
  institutionalEmails InstitutionalEmail[]

  @@schema("users")
}

/// Domains seen in institutional emails that belong to no known organisation.
model DomainReview {
  domain      String             @id
  status      DomainReviewStatus
  requests    Int                @default(1)
  firstSeenAt DateTime           @default(now()) @db.Timestamptz(3)
  decidedAt   DateTime?          @db.Timestamptz(3)
  decidedBy   String?            @db.Uuid

  @@schema("users")
}

model Membership {
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  role           OrgRole
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
  @@schema("users")
}

enum DataExportStatus {
  PENDING
  READY
  FAILED
  EXPIRED

  @@schema("users")
}

/// ADR-0018: an archive of everything about a person, ready within 24 hours and downloadable for 7 days.
model DataExport {
  id          String           @id @db.Uuid
  userId      String           @db.Uuid
  status      DataExportStatus @default(PENDING)
  /// Cross-context reference to notes.FileObject (purpose EXPORT, restricted bucket)
  fileId      String?          @db.Uuid
  sizeBytes   BigInt?
  error       String?
  requestedAt DateTime         @default(now()) @db.Timestamptz(3)
  readyAt     DateTime?        @db.Timestamptz(3)
  expiresAt   DateTime?        @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
  @@index([status, expiresAt])
  @@schema("users")
}

/// Versioned acceptance of Terms, Privacy Policy, public-content licence and guardian consent (§15.2).
model ConsentRecord {
  id         String      @id @db.Uuid
  userId     String      @db.Uuid
  kind       ConsentKind
  version    String
  acceptedAt DateTime    @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@schema("users")
}

/// ADR-0019. Documents are notes.FileObject rows (purpose VERIFICATION_DOCUMENT) referenced by id.
/// What a verification request asks for (ADR-0073): the account verified (ADR-0019), or the TEACHER role.
enum VerificationPurpose {
  ACCOUNT
  TEACHER_ROLE

  @@schema("users")
}

model VerificationRequest {
  id          String                    @id @db.Uuid
  userId      String                    @db.Uuid
  purpose     VerificationPurpose       @default(ACCOUNT)
  method      VerificationMethod
  /// TEACHER_ROLE: where they teach, and what
  institution String?
  subjects    String?
  /// TEACHER method: the verified teacher asked to vouch
  teacherId   String?                   @db.Uuid
  status      VerificationRequestStatus @default(PENDING)
  message     String?
  documentIds String[]                  @db.Uuid
  /// ADR-0099: the one file is a college ID card. Deleted when the request is decided or withdrawn.
  collegeIdCard Boolean                 @default(false)
  decidedBy   String?                   @db.Uuid
  decidedAt   DateTime?                 @db.Timestamptz(3)
  reason      String?
  /// Automated college-ID / proof check. Reviewers see it; the raw image is not stored here.
  aiVerdict    IdCardVerdict?
  /// 0–1. The model's confidence, not a second opinion.
  aiConfidence Float?
  /// Why the verdict was reached. Never the image and never a copy of the model's raw text beyond this sentence.
  aiReason     String?
  /// { name, institution, idNumber, validUntil }. Not written to logs.
  aiExtracted  Json?
  aiCheckedAt  DateTime?                 @db.Timestamptz(3)
  createdAt    DateTime                  @default(now()) @db.Timestamptz(3)

  user User @relation("requester", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([teacherId, status])
  @@index([status, createdAt])
  @@index([collegeIdCard, status, createdAt])
  @@schema("users")
}

/// A platform setting an admin changes without a deploy (ADR-0099, ADR-0100, ADR-0101).
/// `student_id_verification`: a missing row means off.
/// `google_sign_in`: the unified-sign-in migration inserts it on, and a missing row is treated as on.
/// `access_allowlist_enabled`: a missing row means off (everyone may sign in).
/// `enabled` mirrors a boolean value. `value` is `{ "v": <boolean | number | string | null> }` for every type.
model AppSetting {
  key       String   @id
  enabled   Boolean  @default(false)
  /// `{ "v": ... }`. Null on a row written before ADR-0101; readers then use `enabled`.
  value     Json?
  updatedBy String?  @db.Uuid
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@schema("users")
}

/// Emails that may sign up and sign in while `access_allowlist_enabled` is on. Stored lowercased.
/// The migration seeds one row per existing account so current admins keep access.
model AccessAllowlistEntry {
  id        String     @id @db.Uuid
  email     String     @unique @db.Citext
  role      GlobalRole
  note      String?
  /// Who added the row. Null for the migration seed.
  addedById String?    @db.Uuid
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([role])
  @@schema("users")
}

/// ADR-0026
model StudentProfile {
  userId           String       @id @db.Uuid
  department       String?
  /// Lower-cased, punctuation-free department for matching ("cse", "ai ds")
  departmentKey    String?
  yearOfStudy      YearOfStudy?
  /// Cross-context references to notes.Topic (max 50)
  interestTopicIds String[]     @db.Uuid
  showOnProfile    Boolean      @default(false)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([departmentKey, yearOfStudy])
  @@schema("users")
}

/// How a plan's price is quoted. NONE is a plan with no billing period (ADR-0101). Nothing is charged.
enum PlanInterval {
  NONE
  MONTH
  YEAR

  @@schema("users")
}

/// ADR-0024: every limit is data. ADR-0101 adds a price the admin can edit. Nothing is charged.
model Plan {
  id        String       @id @db.Uuid
  code      String       @unique
  name      String
  /// Minor units (paise, cents). 0 is free. Config only (ADR-0101).
  priceMinor Int         @default(0)
  /// ISO 4217
  currency  String       @default("INR")
  interval  PlanInterval @default(NONE)
  /// Short lines for a pricing card. Not entitlements.
  features  String[]     @default([])
  /// False hides it from a pricing list. FREE stays active: accounts without a plan use it.
  active    Boolean      @default(true)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @default(now()) @updatedAt @db.Timestamptz(3)

  entitlements Entitlement[]
  users        UserPlan[]

  @@schema("users")
}

model Entitlement {
  id            String      @id @db.Uuid
  planId        String      @db.Uuid
  key           LimitKey
  /// null = unlimited
  limit         BigInt?
  /// null = every role; a role-specific row wins over the generic one
  appliesToRole GlobalRole?

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key, appliesToRole])
  @@schema("users")
}

model UserPlan {
  userId    String   @id @db.Uuid
  planId    String   @db.Uuid
  startedAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([planId])
  @@schema("users")
}

/// ADR-0023: the old site's data for this account, matched by Firebase UID (Google) or verified email.
model LegacyImport {
  userId      String             @id @db.Uuid
  legacyUid   String?
  status      LegacyImportStatus
  /// { topicsCompleted, topicsToRevisit, problemsMarked, notes, studyDays }
  counts      Json?
  /// Key of the per-user snapshot in the restricted bucket
  snapshotKey String?
  matchedBy   String?
  claimedAt   DateTime?          @db.Timestamptz(3)
  declinedAt  DateTime?          @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([legacyUid])
  @@schema("users")
}

/// §4.5: who changed roles, memberships, verification and moderation state — never content. Kept 7 years (§15.2).
model AuditLog {
  id         String   @id @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String?  @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@schema("users")
}

/// DPDP tombstone of an admin's permanent deletion. The email is a SHA-256 hex digest, never the address itself.
model AccountTombstone {
  id        String   @id @db.Uuid
  userId    String   @db.Uuid
  emailHash String
  adminId   String   @db.Uuid
  reason    String
  deletedAt DateTime @db.Timestamptz(3)

  @@index([emailHash])
  @@map("account_tombstones")
  @@schema("users")
}

/// Unexpected failures and client-reported errors. `message` is scrubbed (no email, token, or document bytes).
/// Kept 90 days. `userId` is null for anonymous failures and for people who opted out of analytics on a client report.
model ErrorEvent {
  id         String         @id @db.Uuid
  occurredAt DateTime       @default(now()) @db.Timestamptz(3)
  userId     String?        @db.Uuid
  /// GraphQL operation, HTTP route, or queue/job.
  route      String?
  /// Error code (VALIDATION, INTERNAL, …) or a client-supplied type.
  code       String
  message    String
  release    String?
  platform   ClientPlatform

  @@index([code, occurredAt])
  @@index([occurredAt])
  @@index([userId, occurredAt])
  @@map("error_events")
  @@schema("users")
}

/// What people use. Dropped at ingest when the account's analytics opt-out is on. Kept 180 days.
model UsageEvent {
  id         String         @id @db.Uuid
  occurredAt DateTime       @default(now()) @db.Timestamptz(3)
  userId     String         @db.Uuid
  sessionId  String?
  /// Allow-listed: page_view, note_open, note_upload, search, download, sign_in.
  name       String
  /// Small JSON. A string `feature` is counted as a feature.
  props      Json?
  platform   ClientPlatform
  appVersion String?

  @@index([name, occurredAt])
  @@index([userId, occurredAt])
  @@index([occurredAt])
  @@map("usage_events")
  @@schema("users")
}

/// Daily counts behind the admin usage metrics (ADR-0106), written by the worker's nightly rollup: one row per IST
/// day, metric and breakdown key. Counts only: no account id, no free text. Kept 730 days.
model DailyMetric {
  day        DateTime @db.Date
  metric     String
  /// A breakdown key, '' when there is none: a sign-up method, a visibility, a cohort's Monday, a duration in ms.
  dimension  String   @default("")
  value      BigInt
  computedAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([day, metric, dimension])
  @@map("daily_metrics")
  @@schema("users")
}

// ── notes ────────────────────────────────────────────────────────────────────────────────────────────────

enum FileStatus {
  PENDING
  UPLOADED
  PROCESSING
  READY
  FAILED
  QUARANTINED
  DELETED

  @@schema("notes")
}

enum FileParentType {
  NOTE
  CARD
  GROUP_POST
  RESOURCE
  AVATAR
  VERIFICATION_REQUEST
  /// ADR-0018: an upload to import notes from
  IMPORT_JOB
  /// ADR-0018: a data export archive
  DATA_EXPORT
  /// ADR-0076: a group's picture
  GROUP

  @@schema("notes")
}

enum FilePurpose {
  ATTACHMENT
  COVER
  VOICE_NOTE
  AVATAR
  IMPORT
  EXPORT
  VERIFICATION_DOCUMENT
  /// ADR-0076: a group's picture, uploaded by an admin and attached to the group then
  GROUP_PICTURE
  /// ADR-0099: a college ID card. Not accepted by createUploadIntent. Restricted bucket only.
  COLLEGE_ID
  /// A PNG or JPEG placed on a note page. Scanned like every other upload.
  PAGE_IMAGE

  @@schema("notes")
}

enum ScanResult {
  CLEAN
  INFECTED
  ERROR
  /// Waiting for the remote scanner (ADR-0102). A file in this state is never served.
  PENDING
  /// The remote scan used its attempts. The file is not served.
  FAILED

  @@schema("notes")
}

/// §8.2: every S3 object has a row, created before the upload; clients only ever see `id`.
model FileObject {
  id                 String         @id @db.Uuid
  /// Cross-context reference to users.User
  ownerId            String         @db.Uuid
  parentType         FileParentType
  parentId           String?        @db.Uuid
  purpose            FilePurpose
  bucket             String
  storageKey         String         @unique
  variants           Json?
  mimeType           String
  detectedMimeType   String?
  sizeBytes          BigInt
  checksumSha256     String?
  width              Int?
  height             Int?
  durationMs         Int?
  pageCount          Int?
  originalFileName   String
  status             FileStatus     @default(PENDING)
  scanResult         ScanResult?
  scannedAt          DateTime?      @db.Timestamptz(3)
  visibilitySnapshot String?
  accessCount        Int            @default(0)
  lastAccessedAt     DateTime?      @db.Timestamptz(3)
  expiresAt          DateTime?      @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?      @db.Timestamptz(3)

  attachments NoteAttachment[]
  pageImages  NotePageImage[]

  @@index([ownerId, status])
  @@index([parentType, parentId])
  @@index([status, expiresAt])
  @@index([scanResult, status])
  @@schema("notes")
}

/// What a note is presented as (ADR-0014, ADR-0015); every kind follows every note rule.
enum NoteKind {
  NOTE
  BLOG
  POST
  PROJECT

  @@schema("notes")
}

/// §4.2: exactly one per note.
enum Visibility {
  PRIVATE
  SHARED
  /// Anyone with the link can read the published version. Left out of public lists, search and profiles.
  UNLISTED
  PUBLIC

  @@schema("notes")
}

/// §4.1: the sixteen card types; content is validated per type with @lvn/contracts/validation.
enum CardType {
  text
  heading
  markdown
  code
  image
  video
  audio
  file
  diagram
  quote
  callout
  checklist
  table
  question
  quiz
  flashcard

  @@schema("notes")
}

/// PUBLISHED: what readers see (§4.3). CONFLICT: the losing side of a card edited on two devices (§13.2).
/// DRAFT: the draft as it was before a version was restored.
enum NoteVersionKind {
  PUBLISHED
  CONFLICT
  DRAFT

  @@schema("notes")
}

enum NoteShareRole {
  EDITOR
  VIEWER

  @@schema("notes")
}

/// How the forker could reach the origin when they forked it (ADR-0010).
enum ForkRole {
  OWNER
  EDITOR
  READER

  @@schema("notes")
}

/// Curated topics come with LVN (seeded from the /core catalog); proposed ones are added by users.
enum TopicOrigin {
  CURATED
  PROPOSED

  @@schema("notes")
}

model Subject {
  id        String   @id @db.Uuid
  slug      String   @unique
  title     String
  position  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  topics Topic[]

  @@schema("notes")
}

model Topic {
  id           String      @id @db.Uuid
  subjectId    String      @db.Uuid
  parentId     String?     @db.Uuid
  slug         String
  title        String
  origin       TopicOrigin
  /// Cross-context reference to users.User; set for PROPOSED topics
  proposedById String?     @db.Uuid
  position     Int         @default(0)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)

  subject  Subject     @relation(fields: [subjectId], references: [id])
  parent   Topic?      @relation("TopicTree", fields: [parentId], references: [id])
  children Topic[]     @relation("TopicTree")
  notes    NoteTopic[]

  @@unique([subjectId, slug])
  @@index([proposedById])
  @@schema("notes")
}

/// Per user, nested (§4.1). Deleting a folder moves what it held up one level.
model Folder {
  id        String   @id @db.Uuid
  /// Cross-context reference to users.User
  ownerId   String   @db.Uuid
  parentId  String?  @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id])
  children Folder[] @relation("FolderTree")
  notes    Note[]

  @@index([ownerId, parentId])
  @@schema("notes")
}

/// Per user; names are unique per user ignoring case.
model Tag {
  id        String   @id @db.Uuid
  ownerId   String   @db.Uuid
  name      String   @db.Citext
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  notes NoteTag[]

  @@unique([ownerId, name])
  @@schema("notes")
}

/// The document (§4.1). Its cards are the draft; readers other than editors see `publishedVersion` (§4.3).
model Note {
  id                    String               @id @db.Uuid
  /// Cross-context reference to users.User
  ownerId               String               @db.Uuid
  folderId              String?              @db.Uuid
  kind                  NoteKind             @default(NOTE)
  title                 String               @default("")
  slug                  String               @default("note")
  visibility            Visibility           @default(PRIVATE)
  /// Bumped by every change to the draft (title, folder, tags, topics or any card)
  draftRevision         Int                  @default(0)
  draftUpdatedAt        DateTime             @default(now()) @db.Timestamptz(3)
  publishedVersionId    String?              @unique @db.Uuid
  publishedAt           DateTime?            @db.Timestamptz(3)
  forkingEnabled        Boolean              @default(true)
  /// Private copies other people have made. Incremented when someone forks.
  forkCount             Int                  @default(0)
  /// Every connection of the owner reads it, live (ADR-0013, ADR-0044): materialised as CONNECTIONS share rows
  sharedWithConnections Boolean              @default(false)
  groupShares           GroupShare[]
  classroomShares       ClassroomShare[]
  contributors          ProjectContributor[]
  /// ADR-0037: only OK notes are readable on the public path; HIDDEN and REMOVED notes by their owner only
  moderation            ModerationState      @default(OK)
  /// Why the note is held, hidden or removed; shown to the owner
  moderationReason      String?
  /// Fork credit (§4.4, ADR-0010): the origin, the version copied and its author (credited even when the origin is gone)
  forkedFromNoteId      String?              @db.Uuid
  forkedFromVersionId   String?              @db.Uuid
  /// Cross-context reference to users.User
  forkedFromOwnerId     String?              @db.Uuid
  /// What the origin was when it was forked: decides whether the fork may become PUBLIC
  forkedFromVisibility  Visibility?
  forkedAsRole          ForkRole?
  deletedAt             DateTime?            @db.Timestamptz(3)
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(3)

  folder           Folder?             @relation(fields: [folderId], references: [id])
  publishedVersion NoteVersion?        @relation("PublishedVersion", fields: [publishedVersionId], references: [id])
  cards            Card[]
  versions         NoteVersion[]       @relation("NoteVersions")
  shares           NoteShare[]
  attachments      NoteAttachment[]
  searchDocument   NoteSearchDocument?
  pdfConversions   PdfConversion[]
  tags             NoteTag[]
  topics           NoteTopic[]
  chunks           NoteChunk[]
  saves            NoteSave[]
  legacyContent    LegacyContentItem?
  pages            NotePage[]

  @@index([ownerId, deletedAt, draftUpdatedAt(sort: Desc)])
  @@index([folderId])
  @@index([visibility, publishedAt(sort: Desc)])
  @@index([forkedFromNoteId])
  @@schema("notes")
}

/// One ordered block of a note's draft (§4.1). `position` is a fractional index compared byte-wise (COLLATE "C").
model Card {
  id        String    @id @db.Uuid
  noteId    String    @db.Uuid
  position  String
  type      CardType
  content   Json
  /// Bumped by every write to this card; clients send the revision they edited (§13.2)
  revision  Int       @default(1)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, position, id])
  @@schema("notes")
}

/// An immutable snapshot of a note's cards (§4.3): never edited, only created, restored from and pruned.
model NoteVersion {
  id          String          @id @db.Uuid
  noteId      String          @db.Uuid
  number      Int
  kind        NoteVersionKind
  title       String
  /// [{ id, type, position, content }] in order
  cards       Json
  /// Cross-context reference to users.User
  createdById String          @db.Uuid
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  note        Note        @relation("NoteVersions", fields: [noteId], references: [id], onDelete: Cascade)
  publishedOf Note?       @relation("PublishedVersion")
  chunks      NoteChunk[]

  @@unique([noteId, number])
  @@index([noteId, kind, createdAt])
  @@schema("notes")
}

/// A piece of a published version, embedded for Ask AI and semantic search (§10.2, ADR-0060): about 500 tokens of the
/// cards' plain text with 50 of overlap. Who may read it is decided when it is retrieved, by the read predicate; it goes
/// with its note and is replaced when a new version is published. `embedding` is written and read with SQL.
model NoteChunk {
  id        String                     @id @db.Uuid
  noteId    String                     @db.Uuid
  versionId String                     @db.Uuid
  /// Its order in the version
  position  Int
  /// The cards it covers, in order
  cardIds   String[]                   @db.Uuid
  text      String
  /// About text length / 4
  tokens    Int
  /// The embedding model: a different one means embedding again
  model     String
  embedding Unsupported("vector(768)")
  createdAt DateTime                   @default(now()) @db.Timestamptz(3)

  note    Note        @relation(fields: [noteId], references: [id], onDelete: Cascade)
  version NoteVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([noteId, position])
  @@index([versionId])
  /// HNSW with vector_cosine_ops, made by the migration: Prisma has no HNSW type, so it is named here only
  @@index([embedding], map: "NoteChunk_embedding_idx")
  @@schema("notes")
}

/// User-level grants (§4.2). Group and classroom shares arrive with groups (Phase 3).
/// A note someone saved to read later (lvn-backend ADR-0076): private to them, shown while they can still read it.
model NoteSave {
  noteId    String   @db.Uuid
  /// Cross-context reference to users.User
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([noteId, userId])
  @@index([userId, createdAt])
  @@schema("notes")
}

model NoteShare {
  noteId      String          @db.Uuid
  /// Cross-context reference to users.User
  userId      String          @db.Uuid
  role        NoteShareRole
  /// DIRECT: shared with this person; CONNECTIONS: they are a connection of the owner, who shares with all (ADR-0044)
  source      NoteShareSource @default(DIRECT)
  createdById String          @db.Uuid
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([noteId, userId])
  @@index([userId])
  @@schema("notes")
}

/// One page of a note. The drawing is vector ink (pen, marker, eraser, ruler); pictures sit on top of it.
model NotePage {
  id        String    @id @db.Uuid
  noteId    String    @db.Uuid
  /// Order on the note, 0-based. Gaps are fine; the reader sorts by this, then id.
  index     Int
  /// `{ strokes: [{ id, tool, color, width, points: [{x,y}] }] }`
  drawing   Json      @default("{\"strokes\":[]}")
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  note   Note            @relation(fields: [noteId], references: [id], onDelete: Cascade)
  images NotePageImage[]

  @@index([noteId, index])
  @@schema("notes")
}

/// A PNG or JPEG placed on a page. The file is a normal upload (scanned, counted against storage).
model NotePageImage {
  id       String @id @db.Uuid
  pageId   String @db.Uuid
  fileId   String @db.Uuid
  x        Float
  y        Float
  width    Float
  height   Float
  /// Degrees, clockwise
  rotation Float  @default(0)

  page NotePage   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  file FileObject @relation(fields: [fileId], references: [id])

  @@index([pageId])
  @@index([fileId])
  @@schema("notes")
}

/// What search finds of a note (§10.4, P2e): its published version, rebuilt by the `search` queue on every publish.
/// Who may see a hit is decided at query time by the note's read predicate, never by this row.
model NoteSearchDocument {
  noteId    String                   @id @db.Uuid
  versionId String                   @db.Uuid
  title     String
  topics    String
  body      String
  /// title (A), topics (B) and body (C), English stemming; written with SQL by the indexer
  document  Unsupported("tsvector")?
  updatedAt DateTime                 @updatedAt @db.Timestamptz(3)

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([document], type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@schema("notes")
}

/// What a search document is about (ADR-0055).
enum SearchEntity {
  NOTE
  USER
  TOPIC
  GROUP
  CLASSROOM
  /// An approved resource (ADR-0075)
  RESOURCE

  @@schema("notes")
}

/// Something that may change a search document (ADR-0055): written by triggers on notes' own tables (in the changing
/// transaction) and by handlers of other contexts' events. The worker drains it in order and deletes the rows it read.
model SearchChange {
  id         BigInt       @id @default(autoincrement())
  entity     SearchEntity
  entityId   String       @db.Uuid
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  /// The Postgres index has it; set only while Typesense is unreachable, so the fallback's index keeps moving
  postgresAt DateTime?    @db.Timestamptz(3)

  @@index([entity, id])
  @@schema("notes")
}

/// A Typesense collection's version behind its alias (ADR-0055). `marker`: the SearchChange id the drainer must pass
/// before the alias moves to this version; null once it has.
model SearchCollection {
  name      String    @id
  version   Int
  marker    BigInt?
  aliasedAt DateTime? @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@schema("notes")
}

/// Sync operations already applied (§13.2): a device that retries gets the first answer again, never a second write.
/// Kept 30 days.
model SyncOpLog {
  clientOpId String   @id @db.Uuid
  /// Cross-context reference to users.User
  userId     String   @db.Uuid
  result     Json
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@schema("notes")
}

enum NoteImportStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  /// The same file was imported before: waiting for the person to confirm
  NEEDS_CONFIRMATION

  @@schema("notes")
}

/// ADR-0018: one import of notes from an uploaded file (purpose IMPORT), run by apps/worker.
model NoteImport {
  id             String           @id @db.Uuid
  /// Cross-context reference to users.User
  userId         String           @db.Uuid
  fileId         String           @db.Uuid
  fileName       String
  /// SHA-256 of the upload: the same file imported again needs a confirmation
  checksum       String?
  allowDuplicate Boolean          @default(false)
  status         NoteImportStatus @default(PENDING)
  /// 0 to 100
  progress       Int              @default(0)
  /// { created, notes: [{ id, title }], skipped: [{ path, reason }] }
  report         Json?
  error          String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  finishedAt     DateTime?        @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([userId, checksum])
  @@schema("notes")
}

/// ADR-0098: what the import of the old site's study content wrote, one row per topic or problem of the old site, so a
/// re-run changes only what changed and leaves alone a note someone has since edited in the app.
model LegacyContentItem {
  /// "topic:<subjectId>/<topicId>" or "problem:<subjectId>/<problemId>", as the old site's Firestore named them
  key        String   @id
  noteId     String   @unique @db.Uuid
  /// legacy-content contentHash of the title, topics and cards last written
  sourceHash String
  /// The version the import published; another one means the note was edited and published in the app since
  versionId  String?  @db.Uuid
  importedAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@schema("notes")
}

/// ADR-0037: where a note stands with moderation (§15.1).
enum ModerationState {
  OK
  PENDING_REVIEW
  HIDDEN
  REMOVED

  @@schema("notes")
}

/// A file uploaded to a note (§8.1 ATTACHMENT), or carried over to a copy of it (§4.4): media cards of the note may
/// show it, and readers of the note get read URLs for it. Files no note links to any more are deleted.
model NoteAttachment {
  noteId    String   @db.Uuid
  fileId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  note       Note            @relation(fields: [noteId], references: [id], onDelete: Cascade)
  file       FileObject      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  highlights NoteHighlight[]

  @@id([noteId, fileId])
  @@index([fileId])
  @@schema("notes")
}

/// A highlight in the PDF reader (ADR-0040): a passage or an area of one page of a PDF attached to the note. The note's
/// owner and editors see and change them, as they see the draft; they are not versioned and copies do not take them.
model NoteHighlight {
  id          String         @id @db.Uuid
  noteId      String         @db.Uuid
  fileId      String         @db.Uuid
  /// 1-based
  page        Int
  kind        HighlightKind
  color       HighlightColor
  /// [[x0, y0, x1, y1], …] as fractions of the page from its top left (@lvn/contracts pageRectSchema)
  rects       Json
  quote       String?
  comment     String?
  /// The card made from it (not a foreign key: cards are soft-deleted and restored with versions)
  cardId      String?        @db.Uuid
  /// Cross-context reference to users.User
  createdById String         @db.Uuid
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  attachment NoteAttachment @relation(fields: [noteId, fileId], references: [noteId, fileId], onDelete: Cascade)

  @@index([noteId, fileId, page])
  @@schema("notes")
}

/// Converting a PDF into a note (ADR-0025, ADR-0028): triage in the notes context, parsing in workers/pdf-engine, the
/// cards made here. The new note is the asker's own; its pages count against PDF_PAGES_MONTHLY unless it failed.
model PdfConversion {
  id           String              @id @db.Uuid
  /// Cross-context reference to users.User: who asked
  userId       String              @db.Uuid
  /// The note the PDF was in
  sourceNoteId String              @db.Uuid
  fileId       String              @db.Uuid
  /// The new note the cards go into
  noteId       String              @db.Uuid
  status       PdfConversionStatus @default(QUEUED)
  /// 0 to 100
  progress     Int                 @default(0)
  pages        Int?
  /// Pages without a text layer, read with OCR
  scannedPages Int?
  cards        Int?
  /// Pages the vision model read again (stage 4, ADR-0063), and how many of its readings were rejected
  aiPages      Int?
  aiRejected   Int?
  error        String?
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  finishedAt   DateTime?           @db.Timestamptz(3)

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([noteId, createdAt])
  @@schema("notes")
}

enum PdfConversionStatus {
  QUEUED
  TRIAGE
  PARSING
  MAPPING
  DONE
  FAILED

  @@schema("notes")
}

enum HighlightKind {
  TEXT
  AREA

  @@schema("notes")
}

enum HighlightColor {
  YELLOW
  GREEN
  BLUE
  PINK
  PURPLE

  @@schema("notes")
}

model NoteTag {
  noteId String @db.Uuid
  tagId  String @db.Uuid

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
  @@schema("notes")
}

model NoteTopic {
  noteId  String @db.Uuid
  topicId String @db.Uuid

  note  Note  @relation(fields: [noteId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id])

  @@id([noteId, topicId])
  @@index([topicId])
  @@schema("notes")
}

// ── core ─────────────────────────────────────────────────────────────────────────────────────────────────

/// Where a progress row came from: the old learnvianotes.in site (ADR-0023) or LVN itself. Declining the old data
/// deletes exactly the LEGACY rows.
enum ProgressOrigin {
  LEGACY
  LVN

  @@schema("core")
}

enum ProblemMark {
  SOLVED
  REVISIT

  @@schema("core")
}

/// Progress on a /core topic (skeleton CoreTopicProgress). topicKey = "subjectId/topicId" of the static content.
model CoreTopicProgress {
  /// Cross-context reference to users.User
  userId         String         @db.Uuid
  topicKey       String
  subjectId      String
  origin         ProgressOrigin
  completed      Boolean        @default(false)
  revisit        Boolean        @default(false)
  secondsStudied Int            @default(0)
  lastStudiedAt  DateTime?      @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  @@id([userId, topicKey, origin])
  @@index([userId, subjectId])
  @@schema("core")
}

/// A mark on a /core interview problem (skeleton CoreProblemMark).
model CoreProblemMark {
  userId    String         @db.Uuid
  subjectId String
  problemId String
  origin    ProgressOrigin
  mark      ProblemMark
  markedAt  DateTime       @default(now()) @db.Timestamptz(3)

  @@id([userId, subjectId, problemId, origin])
  @@index([userId, subjectId])
  @@schema("core")
}

/// Why a learner paused Rhythm (ADR-0030)
enum RhythmPauseReason {
  EXAMS
  ILLNESS
  FESTIVAL
  TRAVEL
  OTHER

  @@schema("core")
}

/// Days a learner paused Rhythm (ADR-0069): paused planned days are neither misses nor needed; at most 14 a term.
model RhythmPause {
  id        String            @id @db.Uuid
  /// Cross-context reference to users.User
  userId    String            @db.Uuid
  from      DateTime          @db.Date
  to        DateTime          @db.Date
  reason    RhythmPauseReason
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  @@index([userId, from])
  @@schema("core")
}

/// A closed Rhythm week (ADR-0069), kept with the target it had: "Rhythm weeks this term" counts the met ones. The
/// current week is computed when asked; a late event reopens its closed week.
model RhythmWeek {
  /// Cross-context reference to users.User
  userId      String   @db.Uuid
  /// The Monday
  weekStart   DateTime @db.Date
  targetDays  Int
  countedDays Int
  comebacks   Int
  pausedDays  Int
  met         Boolean
  closedAt    DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, weekStart])
  @@schema("core")
}

/// An exam a learner prepares for (ADR-0070): a name, a day in their time zone, and its topics.
model Exam {
  id        String         @id @db.Uuid
  /// Cross-context reference to users.User
  userId    String         @db.Uuid
  name      String
  /// A learning day in the person's zone
  date      DateTime       @db.Date
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)
  topics    ExamTopic[]
  tasks     ExamPlanTask[]

  @@index([userId, date])
  @@schema("core")
}

model ExamTopic {
  examId   String @db.Uuid
  /// topic:<uuid> or core:<subject>/<topic>, as learning events name it
  topicKey String
  /// The title when the exam was set, for the plan and the reminders; the notes topic's own title is read live
  title    String
  position Int
  exam     Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@id([examId, topicKey])
  @@schema("core")
}

/// One revision session of an exam's plan (ADR-0070): at most one a day for each exam. Done is computed from learning.
model ExamPlanTask {
  id         String    @id @db.Uuid
  examId     String    @db.Uuid
  /// Cross-context reference to users.User
  userId     String    @db.Uuid
  day        DateTime  @db.Date
  topicKeys  String[]
  /// When the reminder went, so it goes once
  remindedAt DateTime? @db.Timestamptz(3)
  exam       Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, day])
  @@index([userId, day])
  @@schema("core")
}

enum RecommendationKind {
  EXAM_TOPIC
  REVISE_TOPIC
  CONTINUE_NOTE
  QUIZ_ON_TOPIC
  POPULAR_NOTE
  /// An approved resource on an exam or weak topic (ADR-0075)
  RESOURCE

  @@schema("core")
}

/// A recommendation for a learner (ADR-0071): recomputed hourly; every note in it is read through the read rule again
/// when shown.
model Recommendation {
  /// Cross-context reference to users.User
  userId     String             @db.Uuid
  kind       RecommendationKind
  /// A note id, or a topic key (topic:<id>, core:<subject>/<topic>)
  entityId   String
  score      Float
  /// Why, in words
  reason     String
  computedAt DateTime           @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime           @db.Timestamptz(3)

  @@id([userId, kind, entityId])
  @@index([userId, score(sort: Desc)])
  @@schema("core")
}

/// A recommendation the learner set aside (ADR-0071): not shown again until `until`.
model RecommendationDismissal {
  /// Cross-context reference to users.User
  userId   String             @db.Uuid
  kind     RecommendationKind
  entityId String
  until    DateTime           @db.Timestamptz(3)

  @@id([userId, kind, entityId])
  @@schema("core")
}

/// A focus session (ADR-0072): Pomodoro work and rest; the server counts the time between start and end, at most the
/// planned minutes, as focus time on its topic.
model FocusSession {
  id             String    @id @db.Uuid
  /// Cross-context reference to users.User
  userId         String    @db.Uuid
  /// topic:<id> or core:<subject>/<topic>
  topicKey       String?
  /// Cross-context reference to notes.Note
  noteId         String?   @db.Uuid
  plannedMinutes Int
  breakMinutes   Int
  /// Shown to the person's Rhythm buddies during the session
  meetUrl        String?
  startedAt      DateTime  @default(now()) @db.Timestamptz(3)
  endedAt        DateTime? @db.Timestamptz(3)
  focusedSeconds Int       @default(0)

  @@index([userId, endedAt])
  @@index([endedAt, startedAt])
  @@schema("core")
}

enum RhythmBuddyStatus {
  PENDING
  ACCEPTED

  @@schema("core")
}

/// Two learners who see each other studying (ADR-0072): asked by one, accepted by the other; five each at most.
model RhythmBuddy {
  id          String            @id @db.Uuid
  /// Cross-context reference to users.User
  requesterId String            @db.Uuid
  /// Cross-context reference to users.User
  addresseeId String            @db.Uuid
  status      RhythmBuddyStatus @default(PENDING)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  acceptedAt  DateTime?         @db.Timestamptz(3)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@schema("core")
}

/// A quiz result on one topic (ADR-0070), from a QUIZ_COMPLETED learning event with topics: weak topics and Readiness
/// read the last three on each topic.
model TopicQuizResult {
  /// Cross-context reference to users.User
  userId   String   @db.Uuid
  topicKey String
  /// The learning event it came from
  eventId  String   @db.Uuid
  at       DateTime @db.Timestamptz(3)
  answered Int
  correct  Int

  @@id([userId, topicKey, eventId])
  @@index([userId, topicKey, at(sort: Desc)])
  @@schema("core")
}

/// A note whose flashcards a person chose to study (ADR-0068); their own notes' flashcards count without a row.
model StudyNote {
  /// Cross-context reference to users.User
  userId  String   @db.Uuid
  /// Cross-context reference to notes.Note
  noteId  String   @db.Uuid
  addedAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, noteId])
  @@schema("core")
}

/// A person's FSRS state for one flashcard (§14.2, ADR-0068): always the replay of their grades in the order given.
model CardReview {
  /// Cross-context reference to users.User
  userId        String    @db.Uuid
  /// A card id (stable across a note's versions)
  cardId        String    @db.Uuid
  noteId        String    @db.Uuid
  due           DateTime  @db.Timestamptz(3)
  stability     Float
  difficulty    Float
  scheduledDays Int
  learningSteps Int       @default(0)
  reps          Int
  lapses        Int
  /// FSRS state: 0 new, 1 learning, 2 review, 3 relearning
  state         Int
  lastReview    DateTime? @db.Timestamptz(3)
  firstReviewAt DateTime  @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  @@id([userId, cardId])
  @@index([userId, due])
  @@schema("core")
}

/// One grade (ADR-0068): kept for replay and, later, for fitting FSRS to the person.
model CardReviewLog {
  id         String   @id @db.Uuid
  /// Cross-context reference to users.User
  userId     String   @db.Uuid
  cardId     String   @db.Uuid
  /// FSRS grade: 1 again, 2 hard, 3 good, 4 easy
  rating     Int
  reviewedAt DateTime @db.Timestamptz(3)
  durationMs Int      @default(0)
  /// The device's id for the grade: sent twice, it counts once
  clientOpId String   @unique @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, cardId, reviewedAt])
  @@index([userId, reviewedAt])
  @@schema("core")
}

/// A learner's settings for learning (ADR-0067, ADR-0030): the time zone their days are counted in, taken from their
/// device and changeable in settings.
model LearnerSettings {
  /// Cross-context reference to users.User
  userId      String   @id @db.Uuid
  timeZone    String   @default("UTC")
  /// Rhythm's planned days (ADR-0069): 3–6 ISO weekdays, 1 Monday … 7 Sunday
  plannedDays Int[]    @default([1, 2, 4, 6])
  /// Shows their name and counted days on their classes' Rhythm ring (ADR-0072); off by default
  shareRhythm Boolean  @default(false)
  /// An adult shows their achievements and level on their profile (ADR-0080); off by default, never for a minor
  showAchievements Boolean @default(false)
  /// An adult sees their band among adults after a contest closes (ADR-0082); off by default, never for a minor
  contestBands     Boolean @default(false)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@schema("core")
}

/// One person's learning on one local day, summed from learning events as they arrive (ADR-0067): what history and
/// Rhythm read. The day rolls over at 04:00 in their time zone (ADR-0030) and is the day the event happened, so events
/// sent late count where they belong.
model LearningDay {
  /// Cross-context reference to users.User
  userId                String   @db.Uuid
  day                   DateTime @db.Date
  /// Learning actions only (ADR-0030): focus sessions, reviews, quizzes
  learningSeconds       Int      @default(0)
  /// Notes and /core topics open: history shows it, Rhythm does not count it
  readingSeconds        Int      @default(0)
  reviews               Int      @default(0)
  quizAnswers           Int      @default(0)
  events                Int      @default(0)
  /// The old site's study days (ADR-0023), set when a learner claims them and cleared if they decline: its focus
  /// minutes as learning time, its topic time as reading
  legacyLearningSeconds Int      @default(0)
  legacyReadingSeconds  Int      @default(0)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  @@id([userId, day])
  @@schema("core")
}

/// Time and events per topic per local day (ADR-0067): history by topic, weak topics and recommendations read it.
model LearningDayTopic {
  /// Cross-context reference to users.User
  userId        String   @db.Uuid
  day           DateTime @db.Date
  /// topic:<uuid> or core:<subject>/<topic>
  topicKey      String
  seconds       Int      @default(0)
  events        Int      @default(0)
  /// The old site's time on the topic that day (ADR-0023)
  legacySeconds Int      @default(0)

  @@id([userId, day, topicKey])
  @@index([userId, topicKey])
  @@schema("core")
}

// ── Moderation (§15.1, ADR-0037) ─────────────────────────────────────────────────────────────────────────────

enum ReportEntityType {
  NOTE
  USER
  COMMENT
  GROUP_POST
  CLASSROOM_POST
  DOUBT
  GROUP
  RESOURCE

  @@schema("core")
}

enum ReportReason {
  HARASSMENT
  SEXUAL
  SELF_HARM
  HATE
  SPAM
  COPYRIGHT
  OTHER

  @@schema("core")
}

enum ReportStatus {
  OPEN
  RESOLVED

  @@schema("core")
}

enum ModerationActionType {
  APPROVE
  HIDE
  REMOVE
  WARN
  SUSPEND
  DISMISS

  @@schema("core")
}

enum AppealStatus {
  OPEN
  DECIDED

  @@schema("core")
}

/// A report on content: by a person, or by the scorer (reporterId null) when it held content back on its way public.
model Report {
  id           String           @id @db.Uuid
  entityType   ReportEntityType
  /// Cross-context reference: notes.Note or users.User
  entityId     String           @db.Uuid
  /// Cross-context reference to users.User; null when the scorer filed it
  reporterId   String?          @db.Uuid
  reason       ReportReason
  details      String?
  status       ReportStatus     @default(OPEN)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  resolvedAt   DateTime?        @db.Timestamptz(3)
  resolvedById String?          @db.Uuid
  /// Whose queue it is in (ADR-0051): the group's or class's when set, else the platform's
  scope        ModerationScope  @default(PLATFORM)
  scopeId      String?          @db.Uuid

  @@unique([entityType, entityId, reporterId])
  @@index([status, createdAt])
  @@index([scope, scopeId, status])
  @@index([entityType, entityId])
  @@schema("core")
}

/// What a moderator (or the report threshold, actorId null) did about an entity; also written to the audit log.
model ModerationAction {
  id         String               @id @db.Uuid
  entityType ReportEntityType
  entityId   String               @db.Uuid
  action     ModerationActionType
  reason     String?
  actorId    String?              @db.Uuid
  createdAt  DateTime             @default(now()) @db.Timestamptz(3)
  scope      ModerationScope      @default(PLATFORM)
  scopeId    String?              @db.Uuid

  @@index([entityType, entityId, createdAt])
  @@schema("core")
}

/// The author's one appeal against hiding or removing their content (§15.1).
model ModerationAppeal {
  id         String           @id @db.Uuid
  entityType ReportEntityType
  entityId   String           @db.Uuid
  userId     String           @db.Uuid
  message    String
  status     AppealStatus     @default(OPEN)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  decidedAt  DateTime?        @db.Timestamptz(3)
  scope      ModerationScope  @default(PLATFORM)
  scopeId    String?          @db.Uuid

  @@unique([entityType, entityId, userId])
  @@index([status, createdAt])
  @@schema("core")
}

// ── comms ──────────────────────────────────────────────────────────────────────────────────────────────────────────

/// What a notification is about (`@lvn/contracts/notifications` NotificationCategory, §9.3).
enum NotificationCategory {
  COMMENT
  SHARE
  CLASSROOM_POST
  QUIZ_PUBLISHED
  REVISION_REMINDER
  STREAK_AT_RISK
  JOIN_REQUEST
  JOIN_DECISION
  FOLLOW
  CONNECTION
  MENTOR_INVITE
  DOUBT
  FORK_PUBLISHED
  VERIFICATION
  DATA_EXPORT
  NOTES_IMPORT
  CLASSROOM_INVITE
  MODERATION
  /// Someone named the person with @handle in a comment or a post they can read (ADR-0054)
  MENTION
  /// Someone asked the person to be Rhythm buddies, or accepted (ADR-0072)
  RHYTHM_BUDDY
  /// Moderators approved or rejected a resource the person submitted (ADR-0074)
  RESOURCE
  /// An achievement reached (ADR-0080): in the app only
  ACHIEVEMENT

  @@schema("comms")
}

/// Something that happened for a person, shown in-app first (§9.3, ADR-0042). Ids only: never note, comment or
/// message text. Read ones go after 90 days, unread ones after a year.
model Notification {
  id          String               @id @db.Uuid
  /// Cross-context reference to users.User: who it is for
  userId      String               @db.Uuid
  category    NotificationCategory
  /// In-app path to open ("/notes/<id>"), the same on web and phone
  path        String
  /// Cross-context reference to users.User: who did it; null for the system or a deleted account
  actorId     String?              @db.Uuid
  /// Cross-context reference to notes.Note when it is about a note
  noteId      String?              @db.Uuid
  /// Cross-context reference to core.Group when it is about a group (ADR-0045)
  groupId     String?              @db.Uuid
  /// Cross-context reference to core.Classroom when it is about a class (ADR-0046)
  classroomId String?              @db.Uuid
  /// Category facts that are not user content (a decision, counts)
  data        Json?
  readAt      DateTime?            @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, readAt])
  @@index([actorId])
  @@schema("comms")
}

/// How a note came to be shared with someone (ADR-0044).
enum NoteShareSource {
  DIRECT
  CONNECTIONS

  @@schema("notes")
}

/// Two teachers who connected (ADR-0013, ADR-0044): one row per pair, the lower id first.
model Connection {
  userLowId  String   @db.Uuid
  userHighId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  low        User     @relation("connectionLow", fields: [userLowId], references: [id], onDelete: Cascade)
  high       User     @relation("connectionHigh", fields: [userHighId], references: [id], onDelete: Cascade)

  @@id([userLowId, userHighId])
  @@index([userHighId])
  @@schema("users")
}

enum ConnectionRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN

  @@schema("users")
}

/// A teacher asking another to connect (ADR-0013): one pending request per pair, in either direction.
model ConnectionRequest {
  id          String                  @id @db.Uuid
  fromUserId  String                  @db.Uuid
  toUserId    String                  @db.Uuid
  status      ConnectionRequestStatus @default(PENDING)
  createdAt   DateTime                @default(now()) @db.Timestamptz(3)
  respondedAt DateTime?               @db.Timestamptz(3)
  from        User                    @relation("connectionFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to          User                    @relation("connectionTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, status, createdAt(sort: Desc)])
  @@index([fromUserId, status, createdAt(sort: Desc)])
  @@schema("users")
}

/// A teacher's Skills tab, the parts that are one per teacher (ADR-0012, ADR-0044).
model TeacherProfile {
  userId    String   @id @db.Uuid
  headline  String?
  bio       String?
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("users")
}

enum TeacherSkillKind {
  SKILL
  QUALIFICATION
  EXPERIENCE
  /// ADR-0077: open-source work, from a proven GitHub account
  PROJECT
  /// ADR-0077: a paper, book or chapter
  PUBLICATION

  @@schema("users")
}

/// Where a Skills item came from: by hand, or a public source the teacher proved is theirs (ADR-0012, ADR-0077).
enum TeacherSkillSource {
  MANUAL
  GITHUB
  WEBSITE
  ORCID
  OPENALEX

  @@schema("users")
}

/// ADR-0077: imported items wait as drafts until the teacher publishes them; manual items are published as saved.
enum TeacherSkillStatus {
  DRAFT
  PUBLISHED

  @@schema("users")
}

model TeacherSkill {
  id         String             @id @db.Uuid
  userId     String             @db.Uuid
  kind       TeacherSkillKind
  name       String
  detail     String?
  position   Int
  source     TeacherSkillSource @default(MANUAL)
  status     TeacherSkillStatus @default(PUBLISHED)
  /// ADR-0077: where an imported item came from, and when it was last fetched
  sourceUrl  String?
  fetchedAt  DateTime?          @db.Timestamptz(3)
  /// ADR-0077: the proven identifier an imported item came from; removing it removes its items
  identityId String?            @db.Uuid
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  identity   ExternalIdentity?  @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([userId, position])
  @@index([identityId])
  @@schema("users")
}

/// ADR-0077: a public identifier a teacher claims, and its proof
enum ExternalIdentityKind {
  GITHUB
  WEBSITE
  ORCID
  OPENALEX

  @@schema("users")
}

/// ADR-0077: a public identifier a teacher proves is theirs (a code in a GitHub bio or gist, a meta tag on a page)
model ExternalIdentity {
  id         String               @id @db.Uuid
  userId     String               @db.Uuid
  kind       ExternalIdentityKind
  /// A GitHub login, or a page's address
  value      String
  /// What the teacher puts where it proves the identifier is theirs
  code       String
  /// Set while the proof is in place; cleared when a re-check no longer finds it
  verifiedAt DateTime?            @db.Timestamptz(3)
  checkedAt  DateTime?            @db.Timestamptz(3)
  /// When its public data was last imported
  fetchedAt  DateTime?            @db.Timestamptz(3)
  /// Why the last check or import did not work, in words for the teacher
  lastError  String?
  createdAt  DateTime             @default(now()) @db.Timestamptz(3)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills     TeacherSkill[]

  @@unique([userId, kind, value])
  @@index([verifiedAt, fetchedAt])
  @@schema("users")
}

// ── Groups (ADR-0045) ──────────────────────────────────────────────────────────────────────────────────────────────

enum GroupType {
  COMMUNITY
  PROJECT

  @@schema("core")
}

enum GroupPrivacy {
  PUBLIC
  PRIVATE

  @@schema("core")
}

enum GroupJoinPolicy {
  OPEN
  APPROVAL

  @@schema("core")
}

enum GroupRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
  MENTOR

  @@schema("core")
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN

  @@schema("core")
}

/// A community of people (§4.1, ADR-0045). PUBLIC is discoverable; content is for members in every group.
model Group {
  id               String             @id @db.Uuid
  name             String
  description      String?
  type             GroupType          @default(COMMUNITY)
  privacy          GroupPrivacy       @default(PUBLIC)
  /// A PRIVATE group always uses APPROVAL, whatever is stored (ADR-0011)
  joinPolicy       GroupJoinPolicy    @default(APPROVAL)
  /// Cross-context reference to users.User
  ownerId          String             @db.Uuid
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?          @db.Timestamptz(3)
  /// Set when platform moderators removed the group (ADR-0053): why, for its owner alone; the owner may appeal once
  removedReason    String?
  /// Project workspaces (ADR-0048): the PUBLIC PROJECT note that credits the team; cross-context reference to notes.Note
  showcaseNoteId   String?            @db.Uuid
  /// ADR-0076: the group's picture, set by its admins; cross-context reference to notes.FileObject (GROUP_PICTURE)
  pictureFileId    String?            @db.Uuid
  members          GroupMember[]
  requests         GroupJoinRequest[]
  posts            GroupPost[]
  repository       GroupRepository?
  repositoryEvents RepositoryEvent[]
  doubts           Doubt[]
  mentorInvites    MentorInvite[]

  @@index([privacy, deletedAt, createdAt(sort: Desc)])
  @@index([ownerId])
  @@schema("core")
}

model GroupMember {
  groupId    String    @db.Uuid
  /// Cross-context reference to users.User
  userId     String    @db.Uuid
  role       GroupRole @default(MEMBER)
  joinedAt   DateTime  @default(now()) @db.Timestamptz(3)
  /// Moderators mute a member for a time: they cannot post until then
  mutedUntil DateTime? @db.Timestamptz(3)
  group      Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@schema("core")
}

/// A request to join (ADR-0009): one pending per person and group.
model GroupJoinRequest {
  id         String            @id @db.Uuid
  groupId    String            @db.Uuid
  userId     String            @db.Uuid
  status     JoinRequestStatus @default(PENDING)
  message    String?
  reviewedBy String?           @db.Uuid
  reviewedAt DateTime?         @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  group      Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, status, createdAt(sort: Desc)])
  @@index([userId, status])
  @@schema("core")
}

/// A post in a group: rich text (a card's document), for members only.
model GroupPost {
  id               String            @id @db.Uuid
  groupId          String            @db.Uuid
  /// Cross-context reference to users.User
  authorId         String            @db.Uuid
  /// IDEA: on a project workspace's ideas board (ADR-0048)
  kind             GroupPostKind     @default(POST)
  body             Json
  /// ADR-0051: anything but OK is seen by its author and its scope's moderators only
  moderation       ContentModeration @default(OK)
  moderationReason String?
  pinnedAt         DateTime?         @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  editedAt         DateTime?         @db.Timestamptz(3)
  deletedAt        DateTime?         @db.Timestamptz(3)
  group            Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, deletedAt, createdAt(sort: Desc)])
  @@schema("core")
}

/// notes' copy of the groups that exist (ADR-0045), fed by GroupCreated / GroupDeleted.
model GroupRead {
  id        String            @id @db.Uuid
  deletedAt DateTime?         @db.Timestamptz(3)
  members   GroupMemberRead[]
  shares    GroupShare[]

  @@schema("notes")
}

/// notes' copy of group membership (ADR-0045), fed by GroupMembershipChanged: the read predicate joins it.
model GroupMemberRead {
  groupId String    @db.Uuid
  userId  String    @db.Uuid
  group   GroupRead @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId, groupId])
  @@schema("notes")
}

/// A note shared to a group (§4.2): its members read the published version.
model GroupShare {
  noteId     String    @db.Uuid
  groupId    String    @db.Uuid
  /// Cross-context reference to users.User
  sharedById String    @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  note       Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  group      GroupRead @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([noteId, groupId])
  @@index([groupId, createdAt(sort: Desc)])
  @@schema("notes")
}

// ── Classrooms (ADR-0046) ──────────────────────────────────────────────────────────────────────────────────────────

enum ClassroomRole {
  TEACHER
  TA
  STUDENT

  @@schema("core")
}

enum JoinVia {
  CODE
  LINK

  @@schema("core")
}

/// A class a teacher runs (§4.1, ADR-0046): joined by request with its code, or by a staff invite.
model Classroom {
  id          String                 @id @db.Uuid
  name        String
  description String?
  /// Eight characters without look-alikes; replaced on request, the old one then stops working
  joinCode    String                 @unique
  /// Cross-context reference to users.User: the TEACHER who runs it
  ownerId     String                 @db.Uuid
  createdAt   DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime               @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?              @db.Timestamptz(3)
  members     ClassroomMember[]
  requests    ClassroomJoinRequest[]
  invites     ClassroomInvite[]
  posts       ClassroomPost[]
  quizzes     ClassQuiz[]

  @@index([ownerId])
  @@schema("core")
}

model ClassroomMember {
  classroomId String        @db.Uuid
  /// Cross-context reference to users.User
  userId      String        @db.Uuid
  role        ClassroomRole @default(STUDENT)
  joinedAt    DateTime      @default(now()) @db.Timestamptz(3)
  classroom   Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@id([classroomId, userId])
  @@index([userId])
  @@schema("core")
}

/// A request with the class code or link (ADR-0009): one waiting per person and class.
model ClassroomJoinRequest {
  id          String            @id @db.Uuid
  classroomId String            @db.Uuid
  userId      String            @db.Uuid
  via         JoinVia           @default(CODE)
  status      JoinRequestStatus @default(PENDING)
  reviewedBy  String?           @db.Uuid
  reviewedAt  DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  classroom   Classroom         @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([classroomId, status, createdAt])
  @@index([userId, status])
  @@schema("core")
}

/// A staff invite (ADR-0009): the acceptance given in advance; the invited person accepts it within 14 days.
model ClassroomInvite {
  id            String        @id @db.Uuid
  classroomId   String        @db.Uuid
  invitedUserId String        @db.Uuid
  invitedBy     String        @db.Uuid
  role          ClassroomRole @default(STUDENT)
  expiresAt     DateTime      @db.Timestamptz(3)
  acceptedAt    DateTime?     @db.Timestamptz(3)
  declinedAt    DateTime?     @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  classroom     Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([invitedUserId, expiresAt])
  @@index([classroomId])
  @@schema("core")
}

/// An announcement by the class's staff (ADR-0046): rich text, read by every member.
model ClassroomPost {
  id               String            @id @db.Uuid
  classroomId      String            @db.Uuid
  authorId         String            @db.Uuid
  body             Json
  /// ADR-0051: anything but OK is seen by its author and its scope's moderators only
  moderation       ContentModeration @default(OK)
  moderationReason String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  deletedAt        DateTime?         @db.Timestamptz(3)
  classroom        Classroom         @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([classroomId, deletedAt, createdAt(sort: Desc)])
  @@schema("core")
}

/// A quiz a class's staff published to it (ADR-0064); not edited once published, its attempts would no longer match.
model ClassQuiz {
  id           String              @id @db.Uuid
  classroomId  String              @db.Uuid
  /// Cross-context reference to users.User: the teacher or TA who published it
  authorId     String              @db.Uuid
  title        String
  /// Cross-context reference to notes.Note: the note it was made from, when its author could read it
  sourceNoteId String?             @db.Uuid
  publishedAt  DateTime            @default(now()) @db.Timestamptz(3)
  deletedAt    DateTime?           @db.Timestamptz(3)
  classroom    Classroom           @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  questions    ClassQuizQuestion[]
  attempts     QuizAttempt[]

  @@index([classroomId, deletedAt, publishedAt(sort: Desc)])
  @@index([authorId])
  @@schema("core")
}

/// One question: quiz card content (question, choices with their ids, the correct ones, an explanation).
model ClassQuizQuestion {
  id       String       @id @db.Uuid
  quizId   String       @db.Uuid
  position Int
  content  Json
  quiz     ClassQuiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers  QuizAnswer[]

  @@unique([quizId, position])
  @@schema("core")
}

/// One submission of a quiz (ADR-0064): scored on the server; a person's first is their score, later ones practice.
model QuizAttempt {
  id          String       @id @db.Uuid
  quizId      String       @db.Uuid
  /// Cross-context reference to users.User
  userId      String       @db.Uuid
  /// The client's id for the submission: the same one returns the same attempt (§11)
  clientOpId  String       @unique @db.Uuid
  score       Int
  total       Int
  submittedAt DateTime     @default(now()) @db.Timestamptz(3)
  quiz        ClassQuiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]

  @@index([quizId, userId, submittedAt])
  @@index([userId])
  @@schema("core")
}

model QuizAnswer {
  attemptId  String            @db.Uuid
  questionId String            @db.Uuid
  /// The choice ids chosen; empty when the question was left unanswered
  choiceIds  String[]
  correct    Boolean
  attempt    QuizAttempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   ClassQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([attemptId, questionId])
  @@schema("core")
}

/// Who can open a quiz that is not tied to a class. UNLISTED is the link.
enum QuizVisibility {
  PRIVATE
  UNLISTED
  PUBLIC

  @@schema("core")
}

/// A quiz a person made and can share. Attempts are private to the taker; the owner sees aggregates only.
model SharedQuiz {
  id          String         @id @db.Uuid
  /// Cross-context reference to users.User
  ownerId     String         @db.Uuid
  title       String
  visibility  QuizVisibility @default(PRIVATE)
  /// Opaque share link. Stops working when the quiz is Private or in the trash.
  linkToken   String         @unique
  publishedAt DateTime?      @db.Timestamptz(3)
  deletedAt   DateTime?      @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  questions SharedQuizQuestion[]
  attempts  SharedQuizAttempt[]

  @@index([ownerId, deletedAt, updatedAt(sort: Desc)])
  @@schema("core")
}

model SharedQuizQuestion {
  id       String     @id @db.Uuid
  quizId   String     @db.Uuid
  position Int
  content  Json
  quiz     SharedQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers  SharedQuizAnswer[]

  @@unique([quizId, position])
  @@schema("core")
}

model SharedQuizAttempt {
  id          String   @id @db.Uuid
  quizId      String   @db.Uuid
  /// Cross-context reference to users.User. Never listed to the quiz's owner.
  userId      String   @db.Uuid
  clientOpId  String   @unique @db.Uuid
  score       Int
  total       Int
  submittedAt DateTime @default(now()) @db.Timestamptz(3)

  quiz    SharedQuiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers SharedQuizAnswer[]

  @@index([quizId, userId, submittedAt])
  @@index([userId])
  @@schema("core")
}

model SharedQuizAnswer {
  attemptId  String             @db.Uuid
  questionId String             @db.Uuid
  choiceIds  String[]
  correct    Boolean
  attempt    SharedQuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   SharedQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([attemptId, questionId])
  @@schema("core")
}

/// notes' copy of the classes that exist (ADR-0046).
model ClassroomRead {
  id        String                @id @db.Uuid
  deletedAt DateTime?             @db.Timestamptz(3)
  members   ClassroomMemberRead[]
  shares    ClassroomShare[]

  @@schema("notes")
}

/// notes' copy of class membership with the role (ADR-0046): the read predicate and co-teaching read it.
model ClassroomMemberRead {
  classroomId String        @db.Uuid
  userId      String        @db.Uuid
  /// TEACHER, TA or STUDENT
  role        String
  classroom   ClassroomRead @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@id([classroomId, userId])
  @@index([userId, classroomId])
  @@schema("notes")
}

/// A note a class's staff shared with it (§4.2): its members read the published version.
model ClassroomShare {
  noteId      String        @db.Uuid
  classroomId String        @db.Uuid
  sharedById  String        @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  note        Note          @relation(fields: [noteId], references: [id], onDelete: Cascade)
  classroom   ClassroomRead @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@id([noteId, classroomId])
  @@index([classroomId, createdAt(sort: Desc)])
  @@schema("notes")
}

// ── Comments and reactions (ADR-0047) ───────────────────────────────────────────────────────────────────────────

enum CommentTargetType {
  NOTE
  GROUP_POST
  CLASSROOM_POST
  /// An approved resource (ADR-0075)
  RESOURCE

  @@schema("core")
}

enum CommentState {
  VISIBLE
  /// By someone the content's owner restricts: seen by its author and the owner until approved (ADR-0016)
  PENDING_APPROVAL

  @@schema("core")
}

/// A comment or a reply (one level) on a note, a group post or a class announcement (ADR-0047).
model Comment {
  id               String            @id @db.Uuid
  targetType       CommentTargetType
  /// notes.Note, core.GroupPost or core.ClassroomPost
  targetId         String            @db.Uuid
  /// A card of the note the comment is about
  cardId           String?           @db.Uuid
  parentId         String?           @db.Uuid
  /// Cross-context reference to users.User
  authorId         String            @db.Uuid
  /// Whose content it is: the note's owner or the post's author
  ownerId          String            @db.Uuid
  /// Class threads (ADR-0047): only this student and the class's staff see it; null for everyone who reads the target
  visibleTo        String?           @db.Uuid
  body             Json
  state            CommentState      @default(VISIBLE)
  /// ADR-0051: anything but OK is seen by its author and its scope's moderators only
  moderation       ContentModeration @default(OK)
  moderationReason String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  editedAt         DateTime?         @db.Timestamptz(3)
  deletedAt        DateTime?         @db.Timestamptz(3)
  parent           Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies          Comment[]         @relation("CommentReplies")

  @@index([targetType, targetId, parentId, createdAt])
  @@index([parentId, createdAt])
  /// Trending (ADR-0076): comments of the last days
  @@index([targetType, createdAt])
  @@index([authorId])
  @@schema("core")
}

enum ReactionTargetType {
  NOTE
  COMMENT
  GROUP_POST
  CLASSROOM_POST

  @@schema("core")
}

enum ReactionKind {
  LIKE
  HELPFUL
  CELEBRATE

  @@schema("core")
}

/// One reaction per person per target (ADR-0047).
model Reaction {
  targetType ReactionTargetType
  targetId   String             @db.Uuid
  /// Cross-context reference to users.User
  userId     String             @db.Uuid
  kind       ReactionKind
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)

  @@id([targetType, targetId, userId])
  @@index([targetType, targetId, kind])
  @@index([userId])
  /// Trending (ADR-0076): reactions of the last days
  @@index([targetType, createdAt])
  @@schema("core")
}

// ── Project workspaces (ADR-0048) ───────────────────────────────────────────────────────────────────────────────

enum GroupPostKind {
  POST
  IDEA

  @@schema("core")
}

enum RepositoryProvider {
  GITHUB
  GITLAB

  @@schema("core")
}

// ── Resources (§14.4, ADR-0074) ─────────────────────────────────────────────────────────────────────────────────────

enum ResourceType {
  BOOK
  COURSE
  TOOL
  SOFTWARE
  HARDWARE
  OTHER

  @@schema("core")
}

enum ResourceStatus {
  /// Waiting for platform moderators: seen by its submitter and moderators only
  PENDING
  APPROVED
  /// Rejected, or removed after approval; `reason` says why
  REJECTED

  @@schema("core")
}

/// A resource of the learning catalogue. No commerce fields (price, store, seller, affiliate): a test reads this model.
model Resource {
  id              String                   @id @db.Uuid
  type            ResourceType
  title           String
  description     String?
  /// As the submitter gave it, after normaliseUrl (no tracking or affiliate parameters)
  url             String
  /// normaliseUrl(url) without the scheme: one key for http and https, for duplicates
  urlKey          String
  /// ISBN-13, for books
  isbn            String?
  /// "By": the author or maker
  author          String?
  /// Cross-context reference to notes.File (purpose COVER, parent RESOURCE)
  coverFileId     String?                  @db.Uuid
  /// Cross-context reference to users.User
  submittedById   String                   @db.Uuid
  status          ResourceStatus           @default(PENDING)
  /// The moderator's reason for a rejection or a removal, for the submitter
  reason          String?
  decidedAt       DateTime?                @db.Timestamptz(3)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(3)
  topics          ResourceTopic[]
  saves           ResourceSave[]
  recommendations ResourceRecommendation[]

  @@index([status, createdAt])
  @@index([submittedById, createdAt])
  @@index([urlKey])
  @@index([isbn])
  @@schema("core")
}

/// A person keeps a resource in their Saved list (ADR-0075). Private: nobody sees who saved what, only how many.
model ResourceSave {
  resourceId String   @db.Uuid
  /// Cross-context reference to users.User
  userId     String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([resourceId, userId])
  @@index([userId, createdAt])
  @@index([resourceId, createdAt])
  @@schema("core")
}

enum ResourceRecommendationTarget {
  USER
  GROUP
  CLASSROOM

  @@schema("core")
}

/// A resource someone recommends to a person, a group or a class, with a short reason (ADR-0075).
model ResourceRecommendation {
  id         String                       @id @db.Uuid
  resourceId String                       @db.Uuid
  /// Cross-context reference to users.User
  fromUserId String                       @db.Uuid
  targetType ResourceRecommendationTarget
  /// The person, the group or the class
  targetId   String                       @db.Uuid
  reason     String?
  createdAt  DateTime                     @default(now()) @db.Timestamptz(3)
  resource   Resource                     @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, targetType, targetId, fromUserId])
  @@index([targetType, targetId, createdAt])
  @@index([fromUserId])
  @@schema("core")
}

model ResourceTopic {
  resourceId String   @db.Uuid
  /// Cross-context reference to notes.Topic (a curated topic)
  topicId    String   @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([resourceId, topicId])
  @@index([topicId])
  @@schema("core")
}

/// A workspace's linked repository: public details from the provider's API when it shows them, else the link only.
model GroupRepository {
  groupId        String              @id @db.Uuid
  provider       RepositoryProvider
  url            String
  /// owner/repo on GitHub, the namespace path on GitLab
  path           String
  /// The provider showed it: name, description, language, stars, last push
  available      Boolean             @default(false)
  metadata       Json?
  refreshedAt    DateTime?           @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  /// ADR-0078: the GitHub App installation confirmed for this repository; its activity comes by webhook
  installationId String?
  group          Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  installation   GitHubInstallation? @relation(fields: [installationId], references: [id], onDelete: SetNull)

  @@index([refreshedAt])
  @@index([installationId])
  @@schema("core")
}

/// ADR-0078: a GitHub App installation that the person who made it confirmed with their own token
model GitHubInstallation {
  /// GitHub's installation id
  id           String            @id
  /// The user or organisation it is installed on
  accountLogin String
  /// Cross-context reference to users.User: who connected it
  createdById  String            @db.Uuid
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  repositories GroupRepository[]

  @@schema("core")
}

/// ADR-0078: a webhook delivery, stored when received and handled by the worker; kept 30 days to drop repeats
model GitHubDelivery {
  /// X-GitHub-Delivery
  id         String    @id
  event      String
  payload    Json
  receivedAt DateTime  @default(now()) @db.Timestamptz(3)
  handledAt  DateTime? @db.Timestamptz(3)

  @@index([receivedAt])
  @@schema("core")
}

enum RepositoryEventKind {
  PUSH
  PULL_REQUEST
  ISSUE

  @@schema("core")
}

/// ADR-0078: what happened in a workspace's repository: a commit, a pull request or an issue; never code
model RepositoryEvent {
  id          String              @id @db.Uuid
  groupId     String              @db.Uuid
  kind        RepositoryEventKind
  /// pushed, opened, closed, merged or reopened
  action      String
  /// A commit's first line, or a pull request's or issue's title
  title       String
  number      Int?
  authorLogin String?
  url         String
  at          DateTime            @db.Timestamptz(3)
  deliveryId  String
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  group       Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, at(sort: Desc)])
  @@schema("core")
}

enum DoubtStatus {
  OPEN
  ANSWERED
  RESOLVED

  @@schema("core")
}

/// A question to the workspace's mentor and team (ADR-0015, ADR-0048).
model Doubt {
  id               String            @id @db.Uuid
  groupId          String            @db.Uuid
  /// Cross-context reference to users.User
  authorId         String            @db.Uuid
  title            String
  body             Json
  /// A path, line or commit in the repository
  repoRef          String?
  status           DoubtStatus       @default(OPEN)
  /// ADR-0051: anything but OK is seen by its author and its scope's moderators only
  moderation       ContentModeration @default(OK)
  moderationReason String?
  resolvedById     String?           @db.Uuid
  resolvedAt       DateTime?         @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?         @db.Timestamptz(3)
  group            Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  answers          DoubtAnswer[]

  @@index([groupId, deletedAt, status, createdAt(sort: Desc)])
  @@schema("core")
}

model DoubtAnswer {
  id        String    @id @db.Uuid
  doubtId   String    @db.Uuid
  authorId  String    @db.Uuid
  body      Json
  byMentor  Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  doubt     Doubt     @relation(fields: [doubtId], references: [id], onDelete: Cascade)

  @@index([doubtId, createdAt])
  @@schema("core")
}

/// A teacher asked to mentor a workspace; accepted within 14 days (ADR-0048).
model MentorInvite {
  id         String    @id @db.Uuid
  groupId    String    @db.Uuid
  teacherId  String    @db.Uuid
  invitedBy  String    @db.Uuid
  expiresAt  DateTime  @db.Timestamptz(3)
  acceptedAt DateTime? @db.Timestamptz(3)
  declinedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  group      Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([teacherId, acceptedAt, declinedAt])
  @@index([groupId])
  @@schema("core")
}

enum ContributorRole {
  CONTRIBUTOR
  MENTOR

  @@schema("notes")
}

/// Who a workspace's showcase note credits (ADR-0048), kept from core's ProjectContributorsChanged.
model ProjectContributor {
  noteId  String          @db.Uuid
  userId  String          @db.Uuid
  groupId String          @db.Uuid
  role    ContributorRole
  note    Note            @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([noteId, userId])
  @@index([userId])
  @@schema("notes")
}

// ── Achievements, points and contributor levels (ADR-0080) ─────────────────────────────────────────────────────────

/// What earned (or took back) points: only other people's actions on someone's public work
enum PointsRule {
  REACTION
  FORK
  RESOURCE_APPROVED

  @@schema("core")
}

enum PointsSource {
  NOTE
  RESOURCE

  @@schema("core")
}

/// The points ledger (ADR-0080): append-only. A person's points are the sum of their entries; a reversal is a new,
/// negative entry. `awardKey` makes every award and reversal happen once: rule, source, actor and how many entries that
/// triple already has.
model PointsEntry {
  id         String       @id @db.Uuid
  /// Cross-context reference to users.User: who the points are for
  userId     String       @db.Uuid
  delta      Int
  rule       PointsRule
  sourceType PointsSource
  sourceId   String       @db.Uuid
  /// Cross-context reference to users.User: whose action it was (null for a moderator's approval)
  actorId    String?      @db.Uuid
  /// The notes subject the source belongs to, for subject contributor achievements
  subjectId  String?      @db.Uuid
  subjectTitle String?
  awardKey   String       @unique
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt(sort: Desc)])
  @@index([sourceType, sourceId])
  @@index([actorId, userId, createdAt])
  @@schema("core")
}

enum AchievementKind {
  TOPICS_MASTERED
  QUIZ_MASTER
  EXAM_READY
  RHYTHM_WEEKS
  SUBJECT_CONTRIBUTOR

  @@schema("core")
}

/// An achievement tier a person reached (ADR-0080), awarded once: `key` is the kind, the subject if any and the tier.
model Achievement {
  id           String          @id @db.Uuid
  /// Cross-context reference to users.User
  userId       String          @db.Uuid
  kind         AchievementKind
  /// The threshold reached: 5 topics, 12 weeks, 250 points…
  tier         Int
  /// For SUBJECT_CONTRIBUTOR: the notes subject
  subjectId    String?         @db.Uuid
  subjectTitle String?
  key          String
  earnedAt     DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([userId, key])
  @@index([userId, earnedAt(sort: Desc)])
  @@schema("core")
}

// ── Weekly tasks and cooperative goals (ADR-0081) ──────────────────────────────────────────────────────────────────

enum WeeklyTaskKind {
  /// Flashcards graded
  REVIEWS
  /// Quiz answers, on a topic or any
  QUIZ_ANSWERS
  /// Learning minutes on a topic
  TOPIC_MINUTES

  @@schema("core")
}

/// A goal a person set for one Rhythm week (ADR-0081): at most three a week; progress is read from learning, never
/// stored; an unfinished one simply ends with the week.
model WeeklyTask {
  id         String         @id @db.Uuid
  /// Cross-context reference to users.User
  userId     String         @db.Uuid
  /// The Monday of the week, in the person's zone
  weekStart  DateTime       @db.Date
  kind       WeeklyTaskKind
  target     Int
  /// topic:<uuid> for a topic task
  topicKey   String?
  topicTitle String?
  /// When and where they mean to do it, in their words (at most 140 characters)
  plan       String?
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  @@index([userId, weekStart])
  @@schema("core")
}

/// A class's pooled weekly goal of counted Rhythm days (ADR-0081): on while a row exists; `target` null sizes it from
/// the class's recent weeks.
model ClassGoal {
  /// Cross-context reference to core.Classroom
  classroomId String   @id @db.Uuid
  target      Int?
  setById     String   @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@schema("core")
}

// ── Weekly contests (ADR-0082) ─────────────────────────────────────────────────────────────────────────────────────

enum ContestStatus {
  DRAFT
  PUBLISHED

  @@schema("core")
}

/// A timed set of questions platform admins write; each person makes one attempt while its window is open.
model Contest {
  id            String            @id @db.Uuid
  title         String
  /// Cross-context reference to notes.Subject
  subjectId     String?           @db.Uuid
  subjectTitle  String?
  opensAt       DateTime          @db.Timestamptz(3)
  closesAt      DateTime          @db.Timestamptz(3)
  minutes       Int
  /// Questions each attempt gets, drawn from the pool
  questionCount Int
  status        ContestStatus     @default(DRAFT)
  createdById   String            @db.Uuid
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  publishedAt   DateTime?         @db.Timestamptz(3)
  questions     ContestQuestion[]
  attempts      ContestAttempt[]

  @@index([status, opensAt])
  @@schema("core")
}

model ContestQuestion {
  id              String   @id @db.Uuid
  contestId       String   @db.Uuid
  prompt          String
  /// [{ id, text }], in the order written
  choices         Json
  correctChoiceId String
  explanation     String
  position        Int
  contest         Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@index([contestId, position])
  @@schema("core")
}

/// One person's attempt: its questions and each one's choice order are fixed when it starts.
model ContestAttempt {
  id          String          @id @db.Uuid
  contestId   String          @db.Uuid
  /// Cross-context reference to users.User
  userId      String          @db.Uuid
  startedAt   DateTime        @default(now()) @db.Timestamptz(3)
  deadline    DateTime        @db.Timestamptz(3)
  submittedAt DateTime?       @db.Timestamptz(3)
  /// The questions drawn, in order
  questionIds String[]
  /// Each question's choice ids in the order this person sees them: { questionId: [choiceId…] }
  choiceOrder Json
  score       Int?
  total       Int
  contest     Contest         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  answers     ContestAnswer[]

  @@unique([contestId, userId])
  @@index([userId, startedAt(sort: Desc)])
  @@schema("core")
}

model ContestAnswer {
  attemptId  String         @db.Uuid
  questionId String         @db.Uuid
  choiceId   String
  answeredAt DateTime       @default(now()) @db.Timestamptz(3)
  attempt    ContestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@id([attemptId, questionId])
  @@schema("core")
}

// ── Mock interviews: the data model only (ADR-0083) ────────────────────────────────────────────────────────────────
// Nothing reads or writes these tables yet: no GraphQL, no routes, no UI. A feature built on them is for adults and
// needs its own ADR (consent, recording, who sees feedback). There is no company, job, application or referral here.

enum MockInterviewLevel {
  INTRO
  CORE
  ADVANCED

  @@schema("core")
}

enum MockInterviewKind {
  PEER
  TEACHER
  SELF

  @@schema("core")
}

enum MockInterviewStatus {
  REQUESTED
  SCHEDULED
  DONE
  CANCELLED

  @@schema("core")
}

model MockInterviewTemplate {
  id          String                     @id @db.Uuid
  title       String
  /// topic:<uuid>, when on a topic
  topicKey    String?
  level       MockInterviewLevel
  /// Cross-context reference to users.User
  createdById String                     @db.Uuid
  createdAt   DateTime                   @default(now()) @db.Timestamptz(3)
  questions   MockInterviewQuestion[]
  criteria    InterviewRubricCriterion[]
  interviews  MockInterview[]

  @@schema("core")
}

model MockInterviewQuestion {
  id         String                @id @db.Uuid
  templateId String                @db.Uuid
  prompt     String
  /// What a good answer shows
  signals    String?
  position   Int
  template   MockInterviewTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, position])
  @@schema("core")
}

/// One criterion of a template's rubric: a description for each of four levels, so ratings are anchored.
model InterviewRubricCriterion {
  id         String                @id @db.Uuid
  templateId String                @db.Uuid
  name       String
  /// Four descriptions, level 1 to 4
  levels     String[]
  position   Int
  template   MockInterviewTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, position])
  @@schema("core")
}

model InterviewSlot {
  id         String          @id @db.Uuid
  /// Cross-context reference to users.User
  hostId     String          @db.Uuid
  startsAt   DateTime        @db.Timestamptz(3)
  endsAt     DateTime        @db.Timestamptz(3)
  timeZone   String
  capacity   Int             @default(1)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  interviews MockInterview[]

  @@index([hostId, startsAt])
  @@schema("core")
}

model MockInterview {
  id               String                @id @db.Uuid
  templateId       String                @db.Uuid
  slotId           String?               @db.Uuid
  /// Cross-context reference to users.User
  candidateId      String                @db.Uuid
  /// Cross-context reference to users.User; null when practising alone
  interviewerId    String?               @db.Uuid
  kind             MockInterviewKind
  status           MockInterviewStatus   @default(REQUESTED)
  /// Recorded only with the candidate's consent; off by default
  recordingConsent Boolean               @default(false)
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  template         MockInterviewTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  slot             InterviewSlot?        @relation(fields: [slotId], references: [id], onDelete: SetNull)
  feedback         InterviewFeedback[]

  @@index([candidateId, createdAt(sort: Desc)])
  @@schema("core")
}

model InterviewFeedback {
  id                 String        @id @db.Uuid
  interviewId        String        @db.Uuid
  /// Cross-context reference to users.User
  authorId           String        @db.Uuid
  /// { criterionId: 1–4 }
  scores             Json
  strengths          String?
  nextSteps          String?
  /// Whether the candidate may read it
  visibleToCandidate Boolean       @default(true)
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  interview          MockInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@schema("core")
}

// ── Push, email and preferences (ADR-0050) ──────────────────────────────────────────────────────────────────────

enum DevicePlatform {
  ANDROID
  IOS

  @@schema("comms")
}

/// A phone's native FCM/APNs token (ADR-0021): one person's at a time; pruned when FCM says it is gone.
model DeviceToken {
  token      String         @id
  /// Cross-context reference to users.User
  userId     String         @db.Uuid
  platform   DevicePlatform
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime       @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@schema("comms")
}

/// Only the choices that differ from the defaults (ADR-0050): null keeps the default.
model NotificationPreference {
  userId   String               @db.Uuid
  category NotificationCategory
  push     Boolean?
  email    Boolean?

  @@id([userId, category])
  @@schema("comms")
}

/// Quiet hours, time zone and the weekly digest; no row means the defaults.
model NotificationSettings {
  userId       String    @id @db.Uuid
  quietStart   String    @default("22:00")
  quietEnd     String    @default("07:00")
  timeZone     String    @default("Asia/Kolkata")
  weeklyDigest Boolean   @default(true)
  lastDigestAt DateTime? @db.Timestamptz(3)

  @@schema("comms")
}

// ── Scoped moderation (ADR-0051) ────────────────────────────────────────────────────────────────────────────────

enum ModerationScope {
  PLATFORM
  GROUP
  CLASSROOM

  @@schema("core")
}

/// Moderation of comments, posts, announcements and doubts (core's own content; notes have ModerationState).
enum ContentModeration {
  OK
  PENDING_REVIEW
  HIDDEN
  REMOVED

  @@schema("core")
}

/// Who answers AI calls: the environment's Ollama (ADR-0058) or a connection platform admins set up (ADR-0065).
enum AiProvider {
  OLLAMA
  OPENAI
  ANTHROPIC
  GEMINI
  /// Any server that speaks OpenAI's API: a LiteLLM proxy, OpenRouter, vLLM… (ADR-0065)
  OPENAI_COMPATIBLE

  @@schema("ai")
}

/// A provider account platform admins set up (ADR-0065): its kind, address, key (encrypted with AI_KEYS_SECRET,
/// never shown again) and default models. `mayReceivePrivate` is §10.1's data-processing flag: only a self-hosted
/// model or a provider with a zero-retention agreement may see notes that are not public.
model AiConnection {
  id                    String         @id @db.Uuid
  kind                  AiProvider
  label                 String
  /// null: the kind's own address
  baseUrl               String?
  /// AES-256-GCM: iv.tag.ciphertext, base64url
  apiKeyCipher          String?
  /// The key's last four characters, to tell keys apart
  apiKeyHint            String?
  mayReceivePrivate     Boolean        @default(false)
  enabled               Boolean        @default(true)
  chatModel             String?
  embedModel            String?
  /// Prices of the default models, in millionths of a dollar per million tokens; a task's route has its own
  inputMicroUsdPerMTok  Int            @default(0)
  outputMicroUsdPerMTok Int            @default(0)
  embedMicroUsdPerMTok  Int            @default(0)
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(3)
  routes                AiModelRoute[]
  chatDefaultOf         AiSettings[]   @relation("chatDefault")
  embedDefaultOf        AiSettings[]   @relation("embedDefault")

  @@schema("ai")
}

/// Which connection answers by default (ADR-0065); one row, id 1. With no chat connection, the environment's provider
/// (AI_PROVIDER) answers. `version` goes up with every change to connections, defaults or routes, so every process
/// reads them again on its next call.
model AiSettings {
  id                Int           @id @default(1)
  version           Int           @default(0)
  chatConnectionId  String?       @db.Uuid
  chatConnection    AiConnection? @relation("chatDefault", fields: [chatConnectionId], references: [id], onDelete: SetNull)
  embedConnectionId String?       @db.Uuid
  embedConnection   AiConnection? @relation("embedDefault", fields: [embedConnectionId], references: [id], onDelete: SetNull)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  @@schema("ai")
}

/// What answers each AI task (§10.1, ADR-0058, ADR-0065): a connection and its model, overriding the defaults, so a
/// model can be swapped without a deploy. Prices are per million tokens in millionths of a dollar: 0 for a self-hosted
/// model.
model AiModelRoute {
  task                  String        @id
  /// null: the default connection (or the environment's provider)
  connectionId          String?       @db.Uuid
  connection            AiConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  model                 String
  inputMicroUsdPerMTok  Int           @default(0)
  outputMicroUsdPerMTok Int           @default(0)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(3)

  @@schema("ai")
}

/// One provider call (§10.1): for whom (null for the platform's own jobs), what, which model and prompt, its tokens,
/// cost and time. Daily quotas and the monthly budget are read from here. No content is kept.
model AiUsage {
  id               String     @id @db.Uuid
  userId           String?    @db.Uuid
  task             String
  provider         AiProvider
  /// The connection that answered (ADR-0065); null for the environment's provider. Kept after it is deleted
  connectionId     String?    @db.Uuid
  model            String
  promptId         String?
  promptVersion    Int?
  promptTokens     Int
  completionTokens Int
  costMicroUsd     Int        @default(0)
  latencyMs        Int
  ok               Boolean
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@schema("ai")
}

enum AiArtifactStatus {
  QUEUED
  RUNNING
  READY
  FAILED

  @@schema("ai")
}

/// What an AI task made from a note (ADR-0059): text beside it (summary, concepts, explanation, practice questions,
/// translation, mistakes) or cards waiting to be kept (flashcards, quiz, revision sheet, new notes). Never part of the
/// note (§10.3): its versions are not touched. A person's artifacts are theirs alone; `ownerId` is null for the
/// public-note pipeline's (P5d).
model NoteArtifact {
  id        String           @id @db.Uuid
  noteId    String           @db.Uuid
  /// The published version it was made from; null when made from the draft
  versionId String?          @db.Uuid
  ownerId   String?          @db.Uuid
  task      String
  /// language, cardIds
  options   Json             @default("{}")
  status    AiArtifactStatus
  /// { markdown } or { title, cards: [{ type, content }] }, checked before it is stored
  payload   Json?
  error     String?
  hidden    Boolean          @default(false)
  keptAt    DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)

  @@index([ownerId, noteId, createdAt(sort: Desc)])
  @@index([noteId, task])
  @@schema("ai")
}

/// An Ask AI answer (ADR-0060): the asker's own. Its text grows while the model answers; its sources are the chunks
/// it cites (note, title, version, cards, snippet), all of notes the asker could read when it was asked.
model AiAnswer {
  id        String           @id @db.Uuid
  askerId   String           @db.Uuid
  question  String
  /// THIS_NOTE, MY_NOTES, MY_PLACES, PUBLIC, WORKSPACE
  scope     String
  noteId    String?          @db.Uuid
  /// WORKSPACE: the workspace, and the doubt asked about
  groupId   String?          @db.Uuid
  doubtId   String?          @db.Uuid
  status    AiArtifactStatus
  text      String           @default("")
  /// [{ n, noteId, title, versionId, cardIds, snippet }]
  sources   Json             @default("[]")
  error     String?
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)

  @@index([askerId, createdAt(sort: Desc)])
  @@index([askerId, noteId])
  @@index([askerId, doubtId])
  @@schema("ai")
}
