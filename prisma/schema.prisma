// LearnViaNotes database — one PostgreSQL 16 database today, one schema per bounded context (spec §3, §6.1).
//
// Rules (checked in review and in CI):
// - Every model carries @@schema("users" | "notes" | "core" | "ai" | "comms").
// - No relation (foreign key) crosses schemas; cross-context references are plain UUID columns.
// - Ids are UUIDv7 generated by the application (libs/prisma-base newId()).
// - Indexes ship in the migration that introduces the query (§6.3).
//
// Target shape: docs/architecture/erd.md. Phase 1 adds the `users` models and `notes.FileObject` (uploads); Phase 2
// adds notes, cards, versions, folders, tags, subjects and topics.

generator client {
  provider        = "prisma-client"
  output          = "../libs/prisma-base/src/generated"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  schemas    = ["users", "notes", "core", "ai", "comms"]
  extensions = [vector, pg_trgm, citext]
}

// ── users ────────────────────────────────────────────────────────────────────────────────────────────────

enum GlobalRole {
  STUDENT
  TEACHER
  PLATFORM_ADMIN

  @@schema("users")
}

enum OAuthProvider {
  GOOGLE
  GITHUB
  LINKEDIN

  @@schema("users")
}

enum VerificationMethod {
  INSTITUTIONAL_EMAIL
  TEACHER
  DOCUMENTS

  @@schema("users")
}

enum VerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN

  @@schema("users")
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD

  @@schema("users")
}

enum ConsentKind {
  TERMS
  PRIVACY
  PUBLIC_CONTENT_LICENCE
  /// Verified parental or institutional consent for a minor (§15.2)
  GUARDIAN

  @@schema("users")
}

enum OrgRole {
  ORG_ADMIN
  TEACHER
  STUDENT

  @@schema("users")
}

enum DomainReviewStatus {
  /// Recognised academic suffix: accepted, organisation to be created (ADR-0017)
  ACADEMIC_QUEUED
  /// Unknown domain: platform admin decides
  NEEDS_REVIEW
  APPROVED
  REJECTED

  @@schema("users")
}

enum YearOfStudy {
  YEAR_1
  YEAR_2
  YEAR_3
  YEAR_4
  YEAR_5
  POSTGRADUATE
  GRADUATED
  SCHOOL
  NOT_STUDYING

  @@schema("users")
}

enum LimitKey {
  STORAGE_BYTES
  AI_TOKENS_DAILY
  PDF_PAGES_MONTHLY
  GROUPS_OWNED
  GROUP_MEMBERS
  CLASSROOMS_OWNED
  CLASSROOM_MEMBERS
  PROJECT_WORKSPACES
  EXPORTS_DAILY
  IMPORTS_DAILY
  ORG_SEATS

  @@schema("users")
}

enum LegacyImportStatus {
  NOT_FOUND
  AVAILABLE
  CLAIMED
  DECLINED

  @@schema("users")
}

model User {
  id                      String              @id @db.Uuid
  email                   String              @unique @db.Citext
  handle                  String              @unique
  displayName             String
  /// Argon2id; null for accounts that only sign in with a provider
  passwordHash            String?
  emailVerifiedAt         DateTime?           @db.Timestamptz(3)
  /// Required to finish registration (ADR-0017); never shown to anyone, only the derived age band is used
  dateOfBirth             DateTime?           @db.Date
  registrationCompletedAt DateTime?           @db.Timestamptz(3)
  /// Verified by institutional email, a teacher or platform admins (ADR-0019)
  verifiedAt              DateTime?           @db.Timestamptz(3)
  verificationMethod      VerificationMethod?
  globalRole              GlobalRole          @default(STUDENT)
  /// Cross-context reference to notes.FileObject
  avatarFileId            String?             @db.Uuid
  deletionRequestedAt     DateTime?           @db.Timestamptz(3)
  deletedAt               DateTime?           @db.Timestamptz(3)
  createdAt               DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @db.Timestamptz(3)

  sessions             Session[]
  oauthAccounts        OAuthAccount[]
  emailTokens          EmailToken[]
  institutionalEmails  InstitutionalEmail[]
  consents             ConsentRecord[]
  memberships          Membership[]
  verificationRequests VerificationRequest[] @relation("requester")
  profile              StudentProfile?
  plan                 UserPlan?
  legacyImport         LegacyImport?

  @@schema("users")
}

/// One row per refresh token. Rotation creates the next row in the same family; presenting a rotated token revokes
/// the whole family (§7.1). The access token's `sid` claim is the family id.
model Session {
  id               String    @id @db.Uuid
  userId           String    @db.Uuid
  familyId         String    @db.Uuid
  /// SHA-256 of the 256-bit refresh token
  refreshTokenHash Bytes     @unique
  /// { platform, name, userAgent } — never the IP in clear
  device           Json?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime  @db.Timestamptz(3)
  /// Set when rotated (replacedById) or signed out / revoked
  revokedAt        DateTime? @db.Timestamptz(3)
  replacedById     String?   @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@schema("users")
}

model OAuthAccount {
  id             String        @id @db.Uuid
  userId         String        @db.Uuid
  provider       OAuthProvider
  /// GOOGLE: the Firebase UID (ADR-0007)
  providerUserId String
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@schema("users")
}

/// Single-use links for login-email verification and password reset; only the SHA-256 of the token is stored.
model EmailToken {
  id        String            @id @db.Uuid
  userId    String            @db.Uuid
  purpose   EmailTokenPurpose
  tokenHash Bytes             @unique
  expiresAt DateTime          @db.Timestamptz(3)
  usedAt    DateTime?         @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@schema("users")
}

/// A college or organisation email (ADR-0017). One confirmed address verifies one account at a time (partial unique
/// index in the migration); replacing an address keeps the old one until the new one is confirmed.
model InstitutionalEmail {
  id             String    @id @db.Uuid
  userId         String    @db.Uuid
  email          String    @db.Citext
  domain         String
  organizationId String?   @db.Uuid
  /// HMAC-SHA-256 of the 6-digit code (CODE_HMAC_SECRET)
  codeHash       Bytes?
  codeExpiresAt  DateTime? @db.Timestamptz(3)
  attempts       Int       @default(0)
  verifiedAt     DateTime? @db.Timestamptz(3)
  /// Set when a newer address is confirmed
  replacedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([email])
  @@schema("users")
}

/// Read model of organisations (owned by the admin app later); email domains link users to them (ADR-0017).
model Organization {
  id           String   @id @db.Uuid
  name         String
  emailDomains String[]
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  memberships         Membership[]
  institutionalEmails InstitutionalEmail[]

  @@schema("users")
}

/// Domains seen in institutional emails that belong to no known organisation.
model DomainReview {
  domain      String             @id
  status      DomainReviewStatus
  requests    Int                @default(1)
  firstSeenAt DateTime           @default(now()) @db.Timestamptz(3)
  decidedAt   DateTime?          @db.Timestamptz(3)
  decidedBy   String?            @db.Uuid

  @@schema("users")
}

model Membership {
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  role           OrgRole
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
  @@schema("users")
}

/// Versioned acceptance of Terms, Privacy Policy, public-content licence and guardian consent (§15.2).
model ConsentRecord {
  id         String      @id @db.Uuid
  userId     String      @db.Uuid
  kind       ConsentKind
  version    String
  acceptedAt DateTime    @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@schema("users")
}

/// ADR-0019. Documents are notes.FileObject rows (purpose VERIFICATION_DOCUMENT) referenced by id.
model VerificationRequest {
  id          String                    @id @db.Uuid
  userId      String                    @db.Uuid
  method      VerificationMethod
  /// TEACHER method: the verified teacher asked to vouch
  teacherId   String?                   @db.Uuid
  status      VerificationRequestStatus @default(PENDING)
  message     String?
  documentIds String[]                  @db.Uuid
  decidedBy   String?                   @db.Uuid
  decidedAt   DateTime?                 @db.Timestamptz(3)
  reason      String?
  createdAt   DateTime                  @default(now()) @db.Timestamptz(3)

  user User @relation("requester", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([teacherId, status])
  @@index([status, createdAt])
  @@schema("users")
}

/// ADR-0026
model StudentProfile {
  userId           String       @id @db.Uuid
  department       String?
  /// Lower-cased, punctuation-free department for matching ("cse", "ai ds")
  departmentKey    String?
  yearOfStudy      YearOfStudy?
  /// Cross-context references to notes.Topic (max 50)
  interestTopicIds String[]     @db.Uuid
  showOnProfile    Boolean      @default(false)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([departmentKey, yearOfStudy])
  @@schema("users")
}

/// ADR-0024: every limit is data. Only FREE exists today.
model Plan {
  id        String   @id @db.Uuid
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  entitlements Entitlement[]
  users        UserPlan[]

  @@schema("users")
}

model Entitlement {
  id            String      @id @db.Uuid
  planId        String      @db.Uuid
  key           LimitKey
  /// null = unlimited
  limit         BigInt?
  /// null = every role; a role-specific row wins over the generic one
  appliesToRole GlobalRole?

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key, appliesToRole])
  @@schema("users")
}

model UserPlan {
  userId    String   @id @db.Uuid
  planId    String   @db.Uuid
  startedAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([planId])
  @@schema("users")
}

/// ADR-0023: the old site's data for this account, matched by Firebase UID (Google) or verified email.
model LegacyImport {
  userId      String             @id @db.Uuid
  legacyUid   String?
  status      LegacyImportStatus
  /// { topicsCompleted, topicsToRevisit, problemsMarked, notes, studyDays }
  counts      Json?
  /// Key of the per-user snapshot in the restricted bucket
  snapshotKey String?
  matchedBy   String?
  claimedAt   DateTime?          @db.Timestamptz(3)
  declinedAt  DateTime?          @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([legacyUid])
  @@schema("users")
}

/// §4.5: who changed roles, memberships, verification and moderation state — never content. Kept 7 years (§15.2).
model AuditLog {
  id         String   @id @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String?  @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@schema("users")
}

// ── notes ────────────────────────────────────────────────────────────────────────────────────────────────

enum FileStatus {
  PENDING
  UPLOADED
  PROCESSING
  READY
  FAILED
  QUARANTINED
  DELETED

  @@schema("notes")
}

enum FileParentType {
  NOTE
  CARD
  GROUP_POST
  RESOURCE
  AVATAR
  VERIFICATION_REQUEST

  @@schema("notes")
}

enum FilePurpose {
  ATTACHMENT
  COVER
  VOICE_NOTE
  AVATAR
  IMPORT
  EXPORT
  VERIFICATION_DOCUMENT

  @@schema("notes")
}

enum ScanResult {
  CLEAN
  INFECTED
  ERROR

  @@schema("notes")
}

/// §8.2: every S3 object has a row, created before the upload; clients only ever see `id`.
model FileObject {
  id                 String         @id @db.Uuid
  /// Cross-context reference to users.User
  ownerId            String         @db.Uuid
  parentType         FileParentType
  parentId           String?        @db.Uuid
  purpose            FilePurpose
  bucket             String
  storageKey         String         @unique
  variants           Json?
  mimeType           String
  detectedMimeType   String?
  sizeBytes          BigInt
  checksumSha256     String?
  width              Int?
  height             Int?
  durationMs         Int?
  pageCount          Int?
  originalFileName   String
  status             FileStatus     @default(PENDING)
  scanResult         ScanResult?
  scannedAt          DateTime?      @db.Timestamptz(3)
  visibilitySnapshot String?
  accessCount        Int            @default(0)
  lastAccessedAt     DateTime?      @db.Timestamptz(3)
  expiresAt          DateTime?      @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?      @db.Timestamptz(3)

  attachments NoteAttachment[]

  @@index([ownerId, status])
  @@index([parentType, parentId])
  @@index([status, expiresAt])
  @@schema("notes")
}

/// What a note is presented as (ADR-0014, ADR-0015); every kind follows every note rule.
enum NoteKind {
  NOTE
  BLOG
  POST
  PROJECT

  @@schema("notes")
}

/// §4.2: exactly one per note.
enum Visibility {
  PRIVATE
  SHARED
  PUBLIC

  @@schema("notes")
}

/// §4.1: the sixteen card types; content is validated per type with @lvn/contracts/validation.
enum CardType {
  text
  heading
  markdown
  code
  image
  video
  audio
  file
  diagram
  quote
  callout
  checklist
  table
  question
  quiz
  flashcard

  @@schema("notes")
}

/// PUBLISHED: what readers see (§4.3). CONFLICT: the losing side of a card edited on two devices (§13.2).
/// DRAFT: the draft as it was before a version was restored.
enum NoteVersionKind {
  PUBLISHED
  CONFLICT
  DRAFT

  @@schema("notes")
}

enum NoteShareRole {
  EDITOR
  VIEWER

  @@schema("notes")
}

/// How the forker could reach the origin when they forked it (ADR-0010).
enum ForkRole {
  OWNER
  EDITOR
  READER

  @@schema("notes")
}

/// Curated topics come with LVN (seeded from the /core catalog); proposed ones are added by users.
enum TopicOrigin {
  CURATED
  PROPOSED

  @@schema("notes")
}

model Subject {
  id        String   @id @db.Uuid
  slug      String   @unique
  title     String
  position  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  topics Topic[]

  @@schema("notes")
}

model Topic {
  id           String      @id @db.Uuid
  subjectId    String      @db.Uuid
  parentId     String?     @db.Uuid
  slug         String
  title        String
  origin       TopicOrigin
  /// Cross-context reference to users.User; set for PROPOSED topics
  proposedById String?     @db.Uuid
  position     Int         @default(0)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)

  subject  Subject     @relation(fields: [subjectId], references: [id])
  parent   Topic?      @relation("TopicTree", fields: [parentId], references: [id])
  children Topic[]     @relation("TopicTree")
  notes    NoteTopic[]

  @@unique([subjectId, slug])
  @@index([proposedById])
  @@schema("notes")
}

/// Per user, nested (§4.1). Deleting a folder moves what it held up one level.
model Folder {
  id        String   @id @db.Uuid
  /// Cross-context reference to users.User
  ownerId   String   @db.Uuid
  parentId  String?  @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id])
  children Folder[] @relation("FolderTree")
  notes    Note[]

  @@index([ownerId, parentId])
  @@schema("notes")
}

/// Per user; names are unique per user ignoring case.
model Tag {
  id        String   @id @db.Uuid
  ownerId   String   @db.Uuid
  name      String   @db.Citext
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  notes NoteTag[]

  @@unique([ownerId, name])
  @@schema("notes")
}

/// The document (§4.1). Its cards are the draft; readers other than editors see `publishedVersion` (§4.3).
model Note {
  id                   String          @id @db.Uuid
  /// Cross-context reference to users.User
  ownerId              String          @db.Uuid
  folderId             String?         @db.Uuid
  kind                 NoteKind        @default(NOTE)
  title                String          @default("")
  slug                 String          @default("note")
  visibility           Visibility      @default(PRIVATE)
  /// Bumped by every change to the draft (title, folder, tags, topics or any card)
  draftRevision        Int             @default(0)
  draftUpdatedAt       DateTime        @default(now()) @db.Timestamptz(3)
  publishedVersionId   String?         @unique @db.Uuid
  publishedAt          DateTime?       @db.Timestamptz(3)
  forkingEnabled       Boolean         @default(true)
  /// ADR-0037: only OK notes are readable on the public path; HIDDEN and REMOVED notes by their owner only
  moderation           ModerationState @default(OK)
  /// Why the note is held, hidden or removed; shown to the owner
  moderationReason     String?
  /// Fork credit (§4.4, ADR-0010): the origin, the version copied and its author (credited even when the origin is gone)
  forkedFromNoteId     String?         @db.Uuid
  forkedFromVersionId  String?         @db.Uuid
  /// Cross-context reference to users.User
  forkedFromOwnerId    String?         @db.Uuid
  /// What the origin was when it was forked: decides whether the fork may become PUBLIC
  forkedFromVisibility Visibility?
  forkedAsRole         ForkRole?
  deletedAt            DateTime?       @db.Timestamptz(3)
  createdAt            DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(3)

  folder           Folder?             @relation(fields: [folderId], references: [id])
  publishedVersion NoteVersion?        @relation("PublishedVersion", fields: [publishedVersionId], references: [id])
  cards            Card[]
  versions         NoteVersion[]       @relation("NoteVersions")
  shares           NoteShare[]
  attachments      NoteAttachment[]
  searchDocument   NoteSearchDocument?
  tags             NoteTag[]
  topics           NoteTopic[]

  @@index([ownerId, deletedAt, draftUpdatedAt(sort: Desc)])
  @@index([folderId])
  @@index([visibility, publishedAt(sort: Desc)])
  @@index([forkedFromNoteId])
  @@schema("notes")
}

/// One ordered block of a note's draft (§4.1). `position` is a fractional index compared byte-wise (COLLATE "C").
model Card {
  id        String    @id @db.Uuid
  noteId    String    @db.Uuid
  position  String
  type      CardType
  content   Json
  /// Bumped by every write to this card; clients send the revision they edited (§13.2)
  revision  Int       @default(1)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, position, id])
  @@schema("notes")
}

/// An immutable snapshot of a note's cards (§4.3): never edited, only created, restored from and pruned.
model NoteVersion {
  id          String          @id @db.Uuid
  noteId      String          @db.Uuid
  number      Int
  kind        NoteVersionKind
  title       String
  /// [{ id, type, position, content }] in order
  cards       Json
  /// Cross-context reference to users.User
  createdById String          @db.Uuid
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  note        Note  @relation("NoteVersions", fields: [noteId], references: [id], onDelete: Cascade)
  publishedOf Note? @relation("PublishedVersion")

  @@unique([noteId, number])
  @@index([noteId, kind, createdAt])
  @@schema("notes")
}

/// User-level grants (§4.2). Group and classroom shares arrive with groups (Phase 3).
model NoteShare {
  noteId      String        @db.Uuid
  /// Cross-context reference to users.User
  userId      String        @db.Uuid
  role        NoteShareRole
  createdById String        @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([noteId, userId])
  @@index([userId])
  @@schema("notes")
}

/// What search finds of a note (§10.4, P2e): its published version, rebuilt by the `search` queue on every publish.
/// Who may see a hit is decided at query time by the note's read predicate, never by this row.
model NoteSearchDocument {
  noteId    String                   @id @db.Uuid
  versionId String                   @db.Uuid
  title     String
  topics    String
  body      String
  /// title (A), topics (B) and body (C), English stemming; written with SQL by the indexer
  document  Unsupported("tsvector")?
  updatedAt DateTime                 @updatedAt @db.Timestamptz(3)

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([document], type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@schema("notes")
}

/// ADR-0037: where a note stands with moderation (§15.1).
enum ModerationState {
  OK
  PENDING_REVIEW
  HIDDEN
  REMOVED

  @@schema("notes")
}

/// A file uploaded to a note (§8.1 ATTACHMENT), or carried over to a copy of it (§4.4): media cards of the note may
/// show it, and readers of the note get read URLs for it. Files no note links to any more are deleted.
model NoteAttachment {
  noteId    String   @db.Uuid
  fileId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  note Note       @relation(fields: [noteId], references: [id], onDelete: Cascade)
  file FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([noteId, fileId])
  @@index([fileId])
  @@schema("notes")
}

model NoteTag {
  noteId String @db.Uuid
  tagId  String @db.Uuid

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
  @@schema("notes")
}

model NoteTopic {
  noteId  String @db.Uuid
  topicId String @db.Uuid

  note  Note  @relation(fields: [noteId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id])

  @@id([noteId, topicId])
  @@index([topicId])
  @@schema("notes")
}

// ── core ─────────────────────────────────────────────────────────────────────────────────────────────────

/// Where a progress row came from: the old learnvianotes.in site (ADR-0023) or LVN itself. Declining the old data
/// deletes exactly the LEGACY rows.
enum ProgressOrigin {
  LEGACY
  LVN

  @@schema("core")
}

enum ProblemMark {
  SOLVED
  REVISIT

  @@schema("core")
}

/// Progress on a /core topic (skeleton CoreTopicProgress). topicKey = "subjectId/topicId" of the static content.
model CoreTopicProgress {
  /// Cross-context reference to users.User
  userId         String         @db.Uuid
  topicKey       String
  subjectId      String
  origin         ProgressOrigin
  completed      Boolean        @default(false)
  revisit        Boolean        @default(false)
  secondsStudied Int            @default(0)
  lastStudiedAt  DateTime?      @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  @@id([userId, topicKey, origin])
  @@index([userId, subjectId])
  @@schema("core")
}

/// A mark on a /core interview problem (skeleton CoreProblemMark).
model CoreProblemMark {
  userId    String         @db.Uuid
  subjectId String
  problemId String
  origin    ProgressOrigin
  mark      ProblemMark
  markedAt  DateTime       @default(now()) @db.Timestamptz(3)

  @@id([userId, subjectId, problemId, origin])
  @@index([userId, subjectId])
  @@schema("core")
}

// ── Moderation (§15.1, ADR-0037) ─────────────────────────────────────────────────────────────────────────────

enum ReportEntityType {
  NOTE
  USER

  @@schema("core")
}

enum ReportReason {
  HARASSMENT
  SEXUAL
  SELF_HARM
  HATE
  SPAM
  COPYRIGHT
  OTHER

  @@schema("core")
}

enum ReportStatus {
  OPEN
  RESOLVED

  @@schema("core")
}

enum ModerationActionType {
  APPROVE
  HIDE
  REMOVE
  WARN
  SUSPEND
  DISMISS

  @@schema("core")
}

enum AppealStatus {
  OPEN
  DECIDED

  @@schema("core")
}

/// A report on content: by a person, or by the scorer (reporterId null) when it held content back on its way public.
model Report {
  id           String           @id @db.Uuid
  entityType   ReportEntityType
  /// Cross-context reference: notes.Note or users.User
  entityId     String           @db.Uuid
  /// Cross-context reference to users.User; null when the scorer filed it
  reporterId   String?          @db.Uuid
  reason       ReportReason
  details      String?
  status       ReportStatus     @default(OPEN)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  resolvedAt   DateTime?        @db.Timestamptz(3)
  resolvedById String?          @db.Uuid

  @@unique([entityType, entityId, reporterId])
  @@index([status, createdAt])
  @@index([entityType, entityId])
  @@schema("core")
}

/// What a moderator (or the report threshold, actorId null) did about an entity; also written to the audit log.
model ModerationAction {
  id         String               @id @db.Uuid
  entityType ReportEntityType
  entityId   String               @db.Uuid
  action     ModerationActionType
  reason     String?
  actorId    String?              @db.Uuid
  createdAt  DateTime             @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@schema("core")
}

/// The author's one appeal against hiding or removing their content (§15.1).
model ModerationAppeal {
  id         String           @id @db.Uuid
  entityType ReportEntityType
  entityId   String           @db.Uuid
  userId     String           @db.Uuid
  message    String
  status     AppealStatus     @default(OPEN)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  decidedAt  DateTime?        @db.Timestamptz(3)

  @@unique([entityType, entityId, userId])
  @@index([status, createdAt])
  @@schema("core")
}
