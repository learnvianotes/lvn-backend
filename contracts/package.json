{
  "name": "@learnvianotes/contracts",
  "version": "0.46.0",
  "description": "LearnViaNotes shared contracts: domain enums, permission matrix, config, event and notification schemas, GraphQL schema. Imported as @lvn/contracts (ADR-0031).",
  "license": "UNLICENSED",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./domain": {
      "import": {
        "types": "./dist/domain/index.d.mts",
        "default": "./dist/domain/index.mjs"
      },
      "require": {
        "types": "./dist/domain/index.d.ts",
        "default": "./dist/domain/index.js"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config/index.d.mts",
        "default": "./dist/config/index.mjs"
      },
      "require": {
        "types": "./dist/config/index.d.ts",
        "default": "./dist/config/index.js"
      }
    },
    "./events": {
      "import": {
        "types": "./dist/events/index.d.mts",
        "default": "./dist/events/index.mjs"
      },
      "require": {
        "types": "./dist/events/index.d.ts",
        "default": "./dist/events/index.js"
      }
    },
    "./notifications": {
      "import": {
        "types": "./dist/notifications/index.d.mts",
        "default": "./dist/notifications/index.mjs"
      },
      "require": {
        "types": "./dist/notifications/index.d.ts",
        "default": "./dist/notifications/index.js"
      }
    },
    "./validation": {
      "import": {
        "types": "./dist/validation/index.d.mts",
        "default": "./dist/validation/index.mjs"
      },
      "require": {
        "types": "./dist/validation/index.d.ts",
        "default": "./dist/validation/index.js"
      }
    },
    "./graphql/*": "./graphql/*"
  },
  "files": [
    "dist",
    "graphql"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "jest --coverage"
  },
  "peerDependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/learnvianotes/lvn-backend.git",
    "directory": "contracts"
  }
}
